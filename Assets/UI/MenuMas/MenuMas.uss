.btn-barra-mas {
    position: absolute;
    top: 13px;
    left: 1300px;
    width: 120px;
    height: 60px;
    border-radius: 15px;
    border-width: 3px;
    -unity-text-align: middle-center;
    font-size: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.flecha-mas {
    width: 10px;
    height: 10px;
    margin-left: 6px;
    /* Aquí puedes asignar una imagen de triángulo vía background-image en el inspector visual */
}

.bloqueador-click-fuera {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.panel-desplegable-mas {
    position: absolute;
    top: 80px;
    left: 1305px;
    width: 220px;
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    padding: 10px;
}

.item-menu-mas {
    height: 45px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
    color: rgb(190, 30, 60);
    font-size: 20px;
}
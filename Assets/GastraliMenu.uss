/* ============================================================
   GastraliMenu.uss
   Adaptación a Unity UI Toolkit del menú web "Gastrali".
   Pensado para una pantalla móvil (Panel Settings en modo
   "Scale With Screen Size" o similar).

   NOTAS DE COMPATIBILIDAD (leer antes de tocar nada):
   - Requiere Unity 2022.2+ (variables USS / custom properties).
   - Las fuentes Fraunces y Work Sans deben importarse como
     Font Assets (TextMeshPro > Font Asset Creator, o Font
     normal de Unity) y asignarse a las variables de abajo
     usando url("project://database/Assets/.../Fraunces.asset")
     o resource("Fraunces"). Sustituye las rutas de ejemplo.
   - No existe box-shadow real: se simula con un borde sutil.
     Si quieres sombra "de verdad", crea un sprite 9-slice de
     sombra y colócalo como un VisualElement detrás de la
     tarjeta (decisión que tomamos en el UXML).
   - No existe position: sticky. La toolbar "pegajosa" se
     resuelve en el UXML colocándola fuera del ScrollView,
     no aquí.
   - "shorthand" de background-image con gradientes CSS no
     existe; el hero usa background-color plano + una imagen
     opcional encima.
   - text-overflow / -unity-text-overflow-position sustituyen
     al line-clamp de 2 líneas del original (no hay line-clamp
     real; ver comentario en .dish-desc).
   ============================================================ */

/* ---------- Design tokens (custom properties) ----------
   Deben definirse en el elemento raíz. En el UXML, pon la
   clase "gastrali-screen" al VisualElement más externo. */
.gastrali-screen {
    --paper: #FAF8F4;
    --ink: #221F1C;
    --ink-soft: #766E64;
    --accent: #C1442B;
    --accent-soft: rgba(193, 68, 43, 0.09);
    --line: #ECE5DA;
    --card-bg: #FFFFFF;

    --radius-sm: 10px;
    --radius-md: 16px;
    --radius-lg: 22px;
    /* Radio "píldora" fijo en vez de 999px. Con valores absurdamente
       altos respecto al tamaño real del elemento, el renderizado de
       esquinas redondeadas de UI Toolkit puede degenerar en esquinas
       picudas — con un valor razonable (mayor que la mitad del alto
       del elemento) se ve igual de redondeado sin ese riesgo. */
    --radius-pill: 21px;

    /* Aproximación de sombra: color de borde algo más oscuro
       que --line, usado en combinación con --card-bg */
    --shadow-line: #E2DACC;

    /* Color de fondo y de letra del recuadro del título (info-card).
       Por defecto igual que el resto de tarjetas, pero se sobreescriben
       en runtime desde MenuController.ApplyTheme() con col_fondo_titulo
       / col_letra_titulo. */
    --bg-titulo: #FFFFFF;
    --color-titulo: #221F1C;

    background-color: var(--paper);
    color: var(--ink);
    flex-grow: 1;
    flex-direction: column;
}

/* Aplica la tipografía base a todo el árbol. Unity no hereda
   fuentes automáticamente en todos los tipos de elemento, así
   que conviene poner esta clase en Label/Button relevantes. */
.font-gral {
   /* -unity-font-definition: url("project://database/Assets/Fonts/WorkSans-SDF.asset"); */
    font-size: 15px;
}
.font-titulo {
   /* -unity-font-definition: url("project://database/Assets/Fonts/Fraunces-SDF.asset"); */
}

/* ---------- Reset de controles nativos de Unity ----------
   ui:Button trae por defecto padding, borde y un fondo con
   gradiente propio del tema del Editor/Runtime. Lo quitamos
   para que .menu-tab / .section-nav-item / .filter-chip
   controlen 100% su apariencia. Aplícalo poniendo SIEMPRE
   estas clases junto a la clase visual (ej: class="menu-tab") */
.menu-tab, .section-nav-item, .filter-chip, .clear-filters-btn {
    border-width: 1px; /* se sobreescribe color/ancho abajo en cada clase */
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.menu-tab:focus, .section-nav-item:focus, .filter-chip:focus, .clear-filters-btn:focus {
    /* Unity añade un anillo de foco azul en builds de Editor/gamepad;
       en pantalla táctil no molesta, pero si quieres quitarlo: */
    outline-width: 0;
}

/* ScrollView interno también trae padding propio (.unity-scroll-view__content-viewport) */
.h-scroll-row {
    padding: 0;
}

/* Botón "Quitar filtros" del filter-sheet */
.clear-filters-btn {
    width: 100%;
    margin-top: 18px;
    padding: 12px;
    border-radius: var(--radius-pill);
    border-color: var(--line);
    background-color: var(--card-bg);
    color: var(--ink-soft);
    font-size: 14px;
}

/* ---------- Splash screen ---------- */
.brand-splash {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(77, 127, 255);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}
.brand-splash.splash-hidden {
    opacity: 0;
}
.brand-splash-logo {
    width: 220px;
    height: 120px; /* ajustar a la relación real del logo */
    -unity-background-scale-mode: scale-to-fit;
    opacity: 1;
}

/* ---------- Contenedor de la app (fade-in tras el splash) ---------- */
.app-root {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    flex-grow: 1;
}
.app-root.app-visible {
    opacity: 1;
}

/* ---------- Hero ---------- */
.hero {
    height: 190px;
    background-color: var(--accent);
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
}
/* Unity no permite overlays por-elemento sin un hijo extra;
   añade en el UXML un VisualElement ".hero-overlay" dentro
   del hero si quieres el degradado oscuro inferior. */
.hero-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0; top: 0;
    background-color: rgba(0, 0, 0, 0);
}
.hero.no-image {
    background-color: var(--accent);
}

/* ---------- Header wrap + info card flotante ---------- */
.header-wrap {
    background-color: var(--card-bg);
    padding-bottom: 0;
}
.fixed-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    background-color: var(--card-bg);
}

.header-spacer {
    width: 100%;
}
.info-card {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    background-color: var(--bg-titulo);
    border-radius: 0;
    border-width: 1px;
    border-color: var(--shadow-line);
    padding: 16px 18px 14px;
}
.rest-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-titulo);
    white-space: normal;
    margin-bottom: 4px;
}

/* ---------- Toolbar (menu tabs + section nav + filtros) ---------- */
.toolbar {
    background-color: var(--card-bg);
    padding: 10px 14px;
}

/* Fila horizontal con scroll: en el UXML usar un ScrollView
   con mode="Horizontal" y aplicar esta clase al contenedor
   de contenido (no al ScrollView en sí). */
.h-scroll-row {
    flex-direction: row;
    flex-wrap: nowrap;
}

.menu-tabs {
    flex-direction: row;
    padding-bottom: 8px;
}
.menu-tab {
    flex-shrink: 0;
    height: 42px;
    padding: 0 16px;
    margin-right: 8px;
    border-radius: var(--radius-pill);
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--card-bg);
    color: var(--ink-soft);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.menu-tab:hover {
    border-color: var(--accent);
}
.menu-tab.active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #FFFFFF;
}

.section-nav {
    flex-direction: row;
}
.section-nav-item {
    flex-shrink: 0;
    height: 40px;
    padding: 0 15px;
    margin-right: 6px;
    border-radius: var(--radius-pill);
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--card-bg);
    color: var(--ink-soft);
    font-size: 13.5px;
    -unity-font-style: bold;
}
.section-nav-item.active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #FFFFFF;
}
.section-nav-row {
    flex-direction: row;
    align-items: center;   
    padding: 4px 0;        
}

#section-nav-scroll {
    margin: 0;
    padding: 0;
}
#section-nav-scroll > #unity-content-and-vertical-scroll-container {
    margin: 0;
    padding: 0;
}
#section-nav-scroll .unity-scroll-view__content-viewport {
    margin: 0;
    padding: 0;
}
#section-nav-scroll .unity-scroll-view__content-container {
    margin: 0;
    padding: 0;
    align-items: center;
}

.filter-chip {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin-left: 8px;
    padding: 0;
    border-radius: var(--radius-pill);
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--card-bg);
    align-items: center;
    justify-content: center;
}

.filter-icon {
    width: 20px;
    height: 20px;
    background-image: url("/Assets/Iconos/filtrar.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink-soft);
}
.filter-chip.active {
    background-color: var(--accent-soft);
    border-color: var(--accent);
}
.filter-chip.active .filter-icon {
    -unity-background-image-tint-color: var(--accent);
}
.filter-chip.veg.active {
    background-color: #E9F3E6;
    border-color: #3F7A34;
    color: #3F7A34;
}
.fcount {
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    margin-left: 4px;
    border-radius: 12px;
    background-color: var(--accent);
    color: #FFFFFF;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.filter-chip .fcount {
    position: absolute;
    top: -6px;
    right: -6px;
    margin-left: 0;
}

/* ---------- Secciones ---------- */
.section {
    padding: 18px 14px 4px;
}
.section-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 10px;
}

/* ---------- Lista de platos ---------- */
.dish-list {
    flex-direction: column;
}
.dish-card {
    flex-direction: row;
    background-color: var(--card-bg);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--shadow-line);
    padding: 12px;
    margin-bottom: 10px;
}
.dish-card.no-img {
    padding: 14px;
}
.dish-thumb {
    width: 74px;
    height: 74px;
    border-radius: var(--radius-sm);
    background-color: var(--paper);
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 12px;
}
.dish-body {
    flex-grow: 1;
    flex-direction: column;
}
.dish-top {
    flex-direction: row;
    justify-content: space-between;
}
.dish-name {
    font-size: 16.5px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: normal;
    flex-shrink: 1;
}
.dish-price {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--accent);
    white-space: nowrap;
}
.dish-desc {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin-top: 3px;
    white-space: normal;
    /* Unity no tiene line-clamp real (webkit-line-clamp).
       Alternativas: (a) truncar el texto en C# a N caracteres
       antes de asignarlo, o (b) fijar max-height + overflow:
       hidden como aproximación burda. Se deja la opción (b): */
    max-height: 34px;
    overflow: hidden;
}
.dish-badges {
    flex-direction: row;
    margin-top: 6px;
}

/* ---------- Badges ---------- */
.badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 7px;
    margin-right: 5px;
    border-radius: var(--radius-pill);
    background-color: var(--accent-soft);
    color: var(--accent);
}
.badge.veg {
    background-color: #E9F3E6;
    color: #3F7A34;
}

.no-results {
    -unity-text-align: upper-center;
    padding: 40px 20px;
    color: var(--ink-soft);
    font-size: 15px;
}

/* ---------- Bottom sheet (modal de detalle de plato) ---------- */
.sheet-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(20, 16, 10, 0.5);
    opacity: 0;
    display: none;
}
.sheet-backdrop.open {
    opacity: 1;
    display: flex;
}

.sheet {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    max-height: 88%;
    background-color: var(--card-bg);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    /* La animación de deslizar hacia arriba/abajo se hace con
       "translate" (Unity 2023.1+) o manipulando "bottom" desde
       C#/UI Toolkit en versiones anteriores. */
    translate: 0 100%;
    transition-property: translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}
.sheet.open {
    translate: 0 0;
}
.sheet.dragging {
    transition-duration: 0s;
}
.sheet-img {
    width: 100%;
    height: 260px;
    -unity-background-scale-mode: scale-and-crop;
}
.sheet-handle {
    width: 36px;
    height: 4px;
    border-radius: 99px;
    background-color: var(--line);
    margin-top: 10px;
    align-self: center;
}
.sheet-body {
    padding: 16px 20px 4px;
}
.sheet-top {
    flex-direction: row;
    justify-content: space-between;
}
.sheet-name {
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}
.sheet-price {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent);
    white-space: nowrap;
}
.sheet-desc {
    font-size: 14.5px;
    color: var(--ink-soft);
    margin-top: 8px;
    white-space: normal;
}
.sheet-badges {
    flex-direction: row;
    margin-top: 10px;
}

/* ---------- Alérgenos ---------- */
.allergens-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ink-soft);
    margin-top: 16px;
}
.allergens {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}
.allergen-chip {
    font-size: 12px;
    padding: 3px 9px;
    margin: 0 6px 6px 0;
    border-radius: 7px;
    background-color: var(--paper);
    border-width: 1px;
    border-color: var(--line);
    color: var(--ink-soft);
}

/* ---------- Grupos de opciones (extras, tamaños...) ---------- */
.option-group {
    margin-top: 18px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: var(--line);
}
.og-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}
.og-title {
    -unity-font-style: bold;
    font-size: 14.5px;
    color: var(--ink);
}
.og-req {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
}
.og-req.required {
    background-color: var(--accent-soft);
    color: var(--accent);
}
.og-req.optional {
    background-color: var(--line);
    color: var(--ink-soft);
}
.og-option {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    font-size: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}
.og-icon {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    border-width: 1.5px;
    border-color: var(--line);
    border-radius: var(--radius-pill); /* radio */
}
.og-icon.checkbox {
    border-radius: 4px;
}
.og-icon.checked {
    background-color: var(--accent);
    border-color: var(--accent);
}
.og-option-name {
    flex-grow: 1;
    color: var(--ink);
}
.og-option-price {
    color: var(--ink-soft);
    -unity-font-style: bold;
    font-size: 13px;
}

/* ---------- Estados (carga / error / vacío) ---------- */
.state {
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    color: var(--ink-soft);
    font-size: 15px;
    -unity-text-align: upper-center;
}
.state-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 6px;
}

/* ---------- Skeletons (placeholders de carga) ----------
   Unity no tiene @keyframes; el "pulse" hay que animarlo
   desde C# (DOTween, o un UnityEvent con schedule.Execute
   variando la opacity), o usar USS transitions alternando
   una clase ".skeleton-pulse" cada X ms. */
.skel-hero {
    height: 190px;
    background-color: var(--line);
}
.skel-card {
    height: 74px;
    margin: 10px 14px 0;
    border-radius: 16px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--shadow-line);
}

/* ---------- Footer ---------- */
.footer-note {
    -unity-text-align: upper-center;
    font-size: 12px;
    color: var(--ink-soft);
    opacity: 0.65;
    padding: 26px 16px 8px;
}

/* ---------- Sheet footer (qty + add button) ---------- */
.sheet-footer {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    border-top-width: 1px;
    border-top-color: var(--line);
    background-color: var(--card-bg);
}
.qty-control {
    flex-direction: row;
    align-items: center;
    background-color: var(--paper);
    border-radius: var(--radius-pill);
    padding: 5px 6px;
    margin-right: 10px;
}
.qty-btn {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 0;
    background-color: var(--card-bg);
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-center;
}
.qty-value {
    font-size: 15px;
    -unity-font-style: bold;
    min-width: 20px;
    -unity-text-align: middle-center;
}
.add-btn {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 42px;
    padding: 0 18px;
    border-width: 0;
    border-radius: 21px;
    background-color: var(--accent);
    -unity-font-style: bold;
    font-size: 15px;
}
.add-btn:disabled {
    opacity: 0.5;
}
.add-btn-label, .add-btn-price {
    color: #FFFFFF;
    -unity-font-style: bold;
}

/* ---------- Bottom nav ---------- */
.bottom-nav {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    flex-direction: row;
    background-color: var(--card-bg);
    border-top-width: 1px;
    border-top-color: var(--line);
    padding: 6px 0;
}
.nav-item {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    height: auto;
    padding: 8px 0; 
    border-width: 0;
    background-color: transparent;
    color: var(--ink-soft);
    font-size: 11px;
    -unity-font-style: bold;
}
.nav-item.active {
    color: var(--accent);
}
.nav-item-label {
    color: inherit;
}
.nav-item-label {
    white-space: nowrap;
    font-size: 13px; /* tamaño letra iconos */
    margin: 0;
    padding: 0;
}
.nav-icon {
    width: 28px;  /* tamaño icono */
    height: 28px;
    margin-bottom: 4px; /* distancia entre icono y palabra */
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink-soft);
}
#nav-menu-icon { background-image: url("/Assets/Iconos/Menu1.png"); }
#nav-pedido-icon { background-image: url("/Assets/Iconos/Pedido1.png"); }
#nav-asistencia-icon { background-image: url("/Assets/Iconos/Asistencia1.png"); }
#nav-pagar-icon { background-image: url("/Assets/Iconos/Pagar1.png"); }

.nav-item.active .nav-icon {
    -unity-background-image-tint-color: var(--accent);
}
.nav-badge {
    position: absolute;
    top: 2px;
    right: 26px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background-color: var(--accent);
    color: #FFFFFF;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---------- Pedido view ---------- */
.pedido-header {
    padding: 16px;
    margin-bottom: 4px;
    background-color: var(--accent);
}
.pedido-header-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.pedido-empty {
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
}
.pedido-empty-big {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 6px;
}
.pedido-empty-sub {
    color: var(--ink-soft);
    font-size: 14px;
    -unity-text-align: upper-center;
}

.pedido-list {
    padding: 16px 14px 4px;
}
.pedido-item {
    flex-direction: row;
    justify-content: space-between;
    background-color: var(--card-bg);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--shadow-line);
    padding: 12px 14px;
    margin-bottom: 10px;
}
.pedido-item-info {
    flex-grow: 1;
    flex-shrink: 1;
}
.pedido-item-name {
    -unity-font-style: bold;
    font-size: 14.5px;
    color: var(--ink);
}
.pedido-item-opts {
    font-size: 12.5px;
    color: var(--ink-soft);
    margin-top: 2px;
}
.pedido-item-price {
    -unity-font-style: bold;
    color: var(--accent);
    font-size: 14.5px;
    white-space: nowrap;
    margin-left: 10px;
}
.pedido-item-controls {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}
.qty-control.small {
    padding: 3px 4px;
}
.qty-control.small .qty-btn {
    width: 26px;
    height: 26px;
    font-size: 15px;
}
.qty-control.small .qty-value {
    font-size: 13px;
    min-width: 16px;
}
.pedido-item-remove {
    width: 28px;
    height: 28px;
    border-width: 0;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    margin-left: 10px;
}
.pedido-item-remove-icon {
    width: 16px;
    height: 16px;
    background-image: url("/Assets/Iconos/basura.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink-soft);
}

.pedido-summary {
    padding: 16px 14px;
    margin: 8px 14px 0;
    border-top-width: 1px;
    border-top-color: var(--line);
}
.pedido-total-row {
    flex-direction: row;
    justify-content: space-between;
    -unity-font-style: bold;
    font-size: 16px;
    padding: 10px 0;
}
.pedido-total-label {
    color: var(--ink);
    -unity-font-style: bold;
}
.pedido-total-value {
    color: var(--ink);
    -unity-font-style: bold;
}
.submit-btn {
    width: 100%;
    padding: 14px;
    border-width: 0;
    border-radius: var(--radius-pill);
    background-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 15px;
}

.pedido-others {
    padding: 0 14px;
    font-size: 13px;
    color: var(--ink-soft);
    margin: 12px 0 0;
    white-space: normal;
}
.pedido-confirmed {
    padding: 16px 14px 4px;
    margin-top: 4px;
}
.pedido-section-title {
    -unity-font-style: bold;
    font-size: 13.5px;
    color: var(--ink);
    margin-bottom: 8px;
}
.pedido-confirmed-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    font-size: 13.5px;
    background-color: var(--card-bg);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--shadow-line);
    padding: 10px 14px;
    margin-bottom: 8px;
}
.pedido-confirmed-status {
    color: var(--ink-soft);
    -unity-font-style: bold;
    white-space: nowrap;
    margin-left: 10px;
}

/* ---------- Toggle de orden de platos ---------- */
.course-toggle-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    font-size: 13px;
    color: var(--ink-soft);
    -unity-font-style: bold;
}
.course-toggle-label {
    flex-shrink: 1;
    white-space: normal;
    margin-right: 10px;
}
.toggle-switch {
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--line);
    flex-shrink: 0;
}
.toggle-knob {
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background-color: #FFFFFF;
    margin-top: 3px;
    margin-left: 3px;
}
.toggle-knob.on {
    translate: 18px 0;
}

/* ---------- Botones de curso (1º / 2º / 3º) ---------- */
.course-btns {
    flex-direction: row;
    margin-top: 6px;
}
.course-btn {
    padding: 4px 10px;
    margin-right: 6px;
    border-radius: 999px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--card-bg);
    color: var(--ink-soft);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---------- Asistencia sheet ---------- */
.asistencia-body {
    -unity-text-align: upper-center;
    padding-top: 14px;
}
.asistencia-title {
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 20px;
}
.asistencia-btn-row {
    flex-direction: row;
}
.asistencia-cancel-btn {
    flex-grow: 1;
    padding: 14px;
    margin-right: 8px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: var(--radius-pill);
    background-color: var(--card-bg);
    color: var(--ink-soft);
    -unity-font-style: bold;
    font-size: 14px;
}
.asistencia-confirm-btn {
    flex-grow: 1;
    padding: 14px;
    margin-left: 8px;
    border-width: 0;
    border-radius: var(--radius-pill);
    background-color: var(--accent);
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 14px;
}

/* ---------- Nav dot (aviso activo) ---------- */
.nav-dot {
    position: absolute;
    top: 2px;
    right: 22px;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background-color: var(--accent);
}

/* ---------- Toast ---------- */
.toast {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 90px;
    background-color: var(--ink);
    color: #FFFFFF;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}
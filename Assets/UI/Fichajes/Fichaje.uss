.fichaje-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(15, 15, 20, 0.55);
    align-items: center;
    justify-content: center;
    -unity-font-definition: resource("Fonts/OpenSans SDF 1");
}

.fichaje-card {
    width: 460px;
    background-color: rgb(255, 255, 255);
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
}

.fichaje-header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 16px;
    margin-bottom: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(240, 240, 242);
}

.fichaje-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: -0.6px;
    color: rgb(30, 30, 34);
    flex-grow: 1;
}

.header-clock {
    font-size: 16px;
    color: rgb(150, 150, 155);
    margin-right: 14px;
}

.fichaje-close {
    width: 32px;
    height: 32px;
    background-color: rgb(240, 240, 242);
    color: rgb(90, 90, 96);
    border-width: 0;
    border-radius: 16px;
    font-size: 18px;
    -unity-font-style: bold;
    padding: 0;
}

/* ---------- PIN screen ---------- */

.pin-restaurant-name {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    color: rgb(150, 150, 155);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.pin-error {
    font-size: 15px;
    color: rgb(200, 45, 45);
    -unity-text-align: middle-center;
    min-height: 22px;
    margin-bottom: 10px;
}

.pin-dots {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 28px;
}

.pin-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: rgb(210, 210, 215);
    background-color: rgba(0, 0, 0, 0);
    margin-left: 8px;
    margin-right: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.pin-dot--filled {
    background-color: rgb(102, 153, 255);
    border-color: rgb(102, 153, 255);
}

.keypad {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.key {
    width: 30%;
    height: 68px;
    margin-bottom: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(228, 228, 231);
    background-color: rgb(248, 248, 250);
    color: rgb(40, 40, 44);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: -0.6px;
    -unity-text-align: middle-center;
}

.key-del {
    color: rgb(150, 150, 155);
    font-size: 20px;
}

.key-enter {
    background-color: rgb(102, 153, 255);
    color: rgb(255, 255, 255);
    border-width: 0;
    font-size: 18px;
}

.key-enter:disabled {
    opacity: 0.4;
}

/* ---------- Confirm screen ---------- */

.stamp-wrap {
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
}

.stamp {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgb(230, 240, 255);
    color: rgb(60, 110, 220);
    border-width: 0;
    font-size: 38px;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
    box-shadow: 0 8px 20px rgba(102, 153, 255, 0.35);
}

.stamp--salida {
    background-color: rgb(222, 245, 227);
    color: rgb(25, 120, 70);
    box-shadow: 0 8px 20px rgba(30, 130, 76, 0.3);
}

.stamp-type {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: -0.6px;
    color: rgb(30, 30, 34);
    -unity-text-align: middle-center;
}

.stamp-employee {
    font-size: 17px;
    color: rgb(110, 110, 116);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.stamp-time {
    font-size: 15px;
    color: rgb(150, 150, 155);
    margin-top: 14px;
    -unity-text-align: middle-center;
}

.return-label {
    font-size: 13px;
    color: rgb(170, 170, 175);
    letter-spacing: 0.4px;
    margin-top: 28px;
    -unity-text-align: middle-center;
}

/* ---------- Hover/focus lock (kiosk touchscreen — no press flash) ---------- */

Button,
Button:hover, Button:focus, Button:active,
Button:focus:hover, Button:hover:active, Button:focus:active {
    background-image: none !important;
    opacity: 1 !important;
    scale: 1 1 !important;
    transition-duration: 0s !important;
}

.key-enter,
.key-enter:hover, .key-enter:focus, .key-enter:active {
    background-color: rgb(102, 153, 255) !important;
    border-width: 0 !important;
}

.fichaje-close,
.fichaje-close:hover, .fichaje-close:focus, .fichaje-close:active {
    background-color: rgb(240, 240, 242) !important;
    border-width: 0 !important;
}

.incidencia-text {
    font-size: 17px;
    color: rgb(60, 60, 65);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 28px;
}

.stepper-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
}

.stepper-group {
    align-items: center;
    width: 70px;
}

.stepper-btn {
    width: 56px;
    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(228, 228, 231);
    background-color: rgb(248, 248, 250);
    color: rgb(102, 153, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.stepper-caption {
    font-size: 11px;
    color: rgb(170, 170, 175);
    margin-top: 2px;
    margin-bottom: 2px;
}

.incidencia-time {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(30, 30, 34);
    width: 140px;
    -unity-text-align: middle-center;
}

.incidencia-confirm-btn {
    width: 100%;
    margin-bottom: 14px;
}
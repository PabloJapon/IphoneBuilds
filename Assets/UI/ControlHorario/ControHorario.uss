/* ══════════════════════════════════════════════════════════════
   CONTROL HORARIO — USS (Unity UI Toolkit)
   v2: unificado con el sistema visual de Reservas.uss y PlanTurnos.uss
   ══════════════════════════════════════════════════════════════ */

:root {
    --naranja: rgb(245, 168, 60);
    --naranja-hover: rgb(230, 148, 40);
    --naranja-suave: rgb(255, 240, 214);
    --vino: rgb(164, 35, 63);

    --azul-suave: rgb(230, 240, 255);
    --azul-texto: rgb(30, 90, 180);

    --cocina: #EA6A1C;
    --cocina-bg: #FFF4EA;
    --sala: #17924B;
    --sala-bg: #EEFDF3;
    --barra: #9333EA;
    --barra-bg: #FAF2FF;
    --repartidor: #DB2777;
    --repartidor-bg: #FEF1F7;

    --gris-950: rgb(30, 30, 34);
    --gris-800: rgb(40, 40, 44);
    --gris-600: rgb(60, 60, 65);
    --gris-500: rgb(90, 90, 96);
    --gris-header: rgb(130, 130, 136);
    --gris-meta: rgb(80, 80, 85);
    --gris-label: rgb(120, 120, 125);
    --gris-400: rgb(150, 150, 155);
    --gris-300: rgb(200, 200, 204);
    --gris-200: rgb(220, 220, 224);
    --gris-150: rgb(225, 225, 228);
    --gris-100: rgb(240, 240, 242);
    --gris-50: rgb(250, 250, 251);
    --bg-pagina: rgb(245, 245, 247);
    --divisor: rgb(235, 235, 238);

    --rojo: rgb(190, 40, 40);
    --rojo-suave: rgb(255, 225, 225);
    --verde: rgb(30, 130, 76);
    --verde-suave: rgb(222, 245, 227);
    --ambar-texto: rgb(180, 120, 10);
    --ambar-suave: rgb(255, 240, 214);
}

.ch-app {
    flex-grow: 1;
    padding: 32px 40px;
    margin-top: 90px;
    background-color: var(--bg-pagina);
    -unity-font-definition: resource("Fonts/Poppins SDF 1");
    color: var(--gris-800);
}

/* ── Cabecera ── */
.ch-title {
    font-size: 32px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: var(--gris-950);
    margin-bottom: 4px;
}
.ch-subtitle { display: none; }

/* ── Card-head con icono ── */
.ch-card-head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.ch-card-icon {
    width: 34px; height: 34px; border-radius: 9px; margin-right: 10px;
    background-color: var(--naranja-suave); color: var(--vino);
    align-items: center; justify-content: center;
}
.ch-card-title { font-size: 19px; -unity-font-style: bold; letter-spacing: -6px; color: var(--gris-800); }
.ch-card-sub { font-size: 16px; color: var(--gris-400); margin-top: 2px; }

/* ── Pestañas ── */
.ch-tabs-nav {
    flex-direction: row;
    background-color: var(--gris-100);
    padding: 5px;
    border-radius: 10px;
    margin-bottom: 20px;
    align-self: flex-start;
}
.ch-tab-btn {
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    padding: 14px 22px;
    font-size: 19px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: var(--gris-500);
    margin: 0;
}
.ch-tab-btn--active { background-color: var(--vino); color: rgb(255, 255, 255); }
.ch-tab-panel { display: flex; }

/* ── Barra de herramientas (vista diaria) ── */
.ch-toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
}
.ch-navbox {
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: var(--gris-200);
    border-radius: 8px;
    padding: 6px;
}
.ch-date-field, .ch-month-field {
    border-width: 0;
    background-color: transparent;
    font-size: 19px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: var(--gris-950);
    min-width: 140px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
}
.ch-icon-btn {
    height: 40px;
    width: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--gris-200);
    background-color: rgb(255, 255, 255);
    color: var(--gris-600);
    -unity-font-style: bold; letter-spacing: -6px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.ch-divider { width: 1px; height: 24px; background-color: var(--gris-200); margin: 0 6px; }

.ch-btn-hoy {
    border-width: 1px;
    border-color: var(--gris-200);
    background-color: rgb(255, 255, 255);
    color: var(--gris-800);
    font-size: 18px;
    -unity-font-style: bold; letter-spacing: -6px;
    padding: 10px 18px;
    border-radius: 8px;
}

/* ── Stat cards ── */
.ch-stat-grid { flex-direction: row; margin-bottom: 20px; }
.ch-stat-box {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: var(--gris-150);
    border-radius: 12px;
    padding: 16px 18px;
    margin-right: 12px;
}
.ch-stat-value { font-size: 32px; -unity-font-style: bold; letter-spacing: -6px; color: var(--gris-950); }
.ch-stat-label { font-size: 18px; color: var(--gris-400); margin-top: 6px; }
.ch-dot-working .ch-stat-value { color: var(--verde); }
.ch-dot-out .ch-stat-value { color: var(--azul-texto); }
.ch-dot-warning .ch-stat-value { color: var(--ambar-texto); }

/* ── Tabla ── */
.ch-table-wrap {
    flex-grow: 1;
    width: 100%;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: var(--gris-150);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 8px;
}
.ch-table { flex-direction: column; flex-grow: 1; width: 100%; min-width: 820px; }

.ch-table-row {
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: var(--divisor);
}
.ch-table-head {
    background-color: var(--gris-50);
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--divisor);
}
.ch-th {
    -unity-font-style: bold; letter-spacing: -6px;
    font-size: 20px;
    color: var(--gris-header);
    padding: 16px 20px;
}
.ch-td { padding: 10px 20px; }

.ch-col-empleado { width: 300px; flex-grow: 0; flex-basis: auto; }
.ch-col-estado   { width: 210px; flex-grow: 0; flex-basis: auto; }
.ch-col-turnos   { flex-grow: 1; flex-basis: 0; }
.ch-col-fecha    { width: 110px; flex-grow: 0; flex-basis: auto; }
.ch-col-entrada  { width: 100px; flex-grow: 0; flex-basis: auto; }
.ch-col-salida   { width: 120px; flex-grow: 0; flex-basis: auto; }
.ch-col-horas    { width: 100px; flex-grow: 0; flex-basis: auto; }
.ch-col-accion   { width: 140px; flex-grow: 0; flex-basis: auto; align-items: flex-end; }

.ch-emp { flex-direction: row; align-items: flex-start; padding: 8px; }
.ch-avatar {
    width: 40px; height: 40px; border-radius: 20px;
    align-items: center; justify-content: center; margin-right: 12px;
    flex-shrink: 0;
}
.ch-avatar Label { font-size: 14px; -unity-font-style: bold; letter-spacing: -6px; }
.ch-name { font-size: 18px; -unity-font-style: bold; letter-spacing: -6px; color: var(--gris-800); white-space: normal; margin-top: 2px; }

.ch-td-muted { color: var(--gris-400); font-size: 18px; }
.ch-td-hours { -unity-font-style: bold; letter-spacing: -6px; color: var(--gris-950); font-size: 20px; }

.btn-detalle {
    background-color: var(--naranja-suave);
    color: var(--vino);
    border-width: 0;
    border-radius: 8px;
    padding: 0 14px;
    height: 34px;
    font-size: 14px;
    -unity-font-style: bold; letter-spacing: -6px;
    white-space: nowrap;
}

.ch-empty {
    color: var(--gris-400);
    font-size: 20px;
    padding: 60px 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── Badges de estado ── */
.ch-badge {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    border-radius: 20px;
    padding: 8px 18px;
    border-width: 0;
    flex-shrink: 0;
}
.ch-badge Label { font-size: 16px; -unity-font-style: bold; letter-spacing: -6px; }
.ch-badge-dot { display: none; }

.badge-working { background-color: var(--verde-suave); }
.badge-working Label { color: var(--verde); }
.badge-working .ch-badge-dot { background-color: var(--verde); }

.badge-out { background-color: var(--gris-100); }
.badge-out { background-color: var(--gris-100); padding-right: 165px; }
.badge-out Label { color: var(--gris-600); }
.badge-out .ch-badge-dot { background-color: var(--gris-400); }

.badge-none { background-color: var(--gris-50); }
.badge-none Label { color: var(--gris-400); }
.badge-none .ch-badge-dot { background-color: var(--gris-300); }

.badge-incompleta { background-color: var(--ambar-suave); }
.badge-incompleta Label { color: var(--ambar-texto); }
.badge-incompleta .ch-badge-dot { background-color: var(--ambar-texto); }

/* ── Filtros del informe ── */
.ch-filtros-card {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: var(--gris-150);
    border-radius: 12px;
    padding: 20px 22px;
    margin-bottom: 20px;
}
.ch-filtros-row { flex-direction: row; flex-wrap: wrap; align-items: flex-end; }
.ch-filtro-group { margin-right: 18px; margin-bottom: 10px; }
.ch-filtro-label { font-size: 18px; color: var(--gris-label); margin-bottom: 6px; }

.ch-select-input {
    border-width: 1px;
    border-color: var(--gris-200);
    border-radius: 8px;
    font-size: 19px;
    color: var(--gris-800);
    background-color: rgb(255, 255, 255);
    min-width: 190px;
    height: 44px;
}
.ch-select-input:focus { border-color: var(--naranja); }

.ch-seg-control {
    flex-direction: row;
    background-color: var(--gris-100);
    border-radius: 8px;
    padding: 4px;
    height: 44px;
}
.ch-seg-btn {
    border-width: 0;
    background-color: transparent;
    padding: 0 16px;
    font-size: 18px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: var(--gris-500);
    border-radius: 8px;
    margin: 0;
    height: 100%;
}
.ch-seg-btn--active { background-color: var(--vino); color: rgb(255, 255, 255); }

.ch-btn-consultar {
    background-color: var(--naranja);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 8px;
    padding: 0 26px;
    font-size: 19px;
    -unity-font-style: bold; letter-spacing: -6px;
    height: 44px;
}

.ch-informe-error {
    display: none;
    color: var(--rojo);
    font-size: 18px;
    margin-top: 10px;
    background-color: var(--rojo-suave);
    border-radius: 8px;
    padding: 10px 12px;
}
.ch-informe-error--visible { display: flex; }

/* ── Cabecera de resultados del informe ── */
.ch-informe-header {
    flex-direction: row; justify-content: space-between; align-items: center;
    flex-wrap: wrap; margin-bottom: 16px;
}
.ch-informe-titulo { font-size: 20px; -unity-font-style: bold; letter-spacing: -6px; color: var(--gris-950); }
.ch-informe-sub { font-size: 16px; color: var(--gris-400); margin-top: 2px; }

.ch-btn-pdf-informe {
    background-color: var(--gris-100);
    color: var(--gris-600);
    border-width: 0;
    border-radius: 8px;
    padding: 0 18px;
    height: 42px;
    font-size: 18px;
    -unity-font-style: bold; letter-spacing: -6px;
}

/* ── Modal detalle de jornada ── */
.modal-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(20, 20, 24, 0.45);
    align-items: center;
    justify-content: center;
}
.modal-box {
    background-color: rgb(255, 255, 255);
    border-radius: 14px;
    border-left-width: 6px;
    border-left-color: var(--naranja);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    width: 460px;
    max-height: 82%;
}
.modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-bottom-width: 1px;
    border-bottom-color: var(--divisor);
}
.modal-header-title { font-size: 20px; -unity-font-style: bold; letter-spacing: -6px; color: var(--gris-950); }
.modal-header-sub { font-size: 16px; color: var(--gris-meta); margin-top: 2px; }
.modal-close {
    background-color: var(--gris-100);
    border-width: 0;
    border-radius: 16px;
    width: 32px; height: 32px;
    color: var(--gris-500);
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    padding: 0;
}
.modal-body { padding: 20px 22px 22px; }

/* Timeline dentro del modal */
.timeline-item { flex-direction: row; margin-bottom: 16px; }
.timeline-icon {
    width: 28px; height: 28px; border-radius: 14px; margin-right: 12px;
    align-items: center; justify-content: center;
}
.timeline-icon Label { font-size: 13px; -unity-font-style: bold; letter-spacing: -6px; }
.timeline-icon.tl-entrada { background-color: var(--verde-suave); }
.timeline-icon.tl-entrada Label { color: var(--verde); }
.timeline-icon.tl-salida { background-color: var(--rojo-suave); }
.timeline-icon.tl-salida Label { color: var(--rojo); }
.timeline-info { flex-grow: 1; }
.timeline-label { font-size: 18px; -unity-font-style: bold; letter-spacing: -6px; color: var(--gris-800); }
.timeline-time { font-size: 17px; color: var(--gris-400); margin-top: 1px; }
.timeline-obs {
    font-size: 17px; color: var(--gris-meta); margin-top: 5px;
    background-color: var(--gris-50); border-radius: 8px; padding: 10px 12px;
}

/* ---------- Custom thin scrollbar — igual que Reservas.uss / PlanTurnos.uss ---------- */

.unity-scroller--vertical {
    width: 10px;
    margin-left: 4px;
}
.unity-scroller--vertical .unity-scroller__low-button,
.unity-scroller--vertical .unity-scroller__high-button {
    width: 0; height: 0; margin: 0; padding: 0; border-width: 0; opacity: 0;
}
.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--gris-300);
    border-radius: 6px;
    border-width: 0;
    width: 6px;
}
.unity-scroller--vertical .unity-base-slider__dragger:hover,
.unity-scroller--vertical .unity-base-slider__dragger:active,
.unity-scroller--vertical .unity-base-slider__dragger:focus {
    background-color: var(--gris-300);
    border-width: 0;
}

/* ── Hover/focus lock — mismo fix que en Reservas.uss / PlanTurnos.uss ── */
Button,
Button:hover,
Button:focus,
Button:active,
Button:focus:hover,
Button:hover:active,
Button:focus:active {
    background-image: none !important;
    opacity: 1 !important;
    scale: 1 1 !important;
    transition-duration: 0s !important;
}

.ch-tab-btn--active,
.ch-tab-btn--active:hover, .ch-tab-btn--active:focus, .ch-tab-btn--active:active,
.ch-tab-btn--active:focus:hover, .ch-tab-btn--active:hover:active, .ch-tab-btn--active:focus:active {
    background-color: var(--vino) !important;
    color: rgb(255, 255, 255) !important;
    border-width: 0 !important;
}

.ch-seg-btn--active,
.ch-seg-btn--active:hover, .ch-seg-btn--active:focus, .ch-seg-btn--active:active,
.ch-seg-btn--active:focus:hover, .ch-seg-btn--active:hover:active, .ch-seg-btn--active:focus:active {
    background-color: var(--vino) !important;
    color: rgb(255, 255, 255) !important;
    border-width: 0 !important;
}

.ch-icon-btn,
.ch-icon-btn:hover, .ch-icon-btn:focus, .ch-icon-btn:active,
.ch-icon-btn:focus:hover, .ch-icon-btn:hover:active, .ch-icon-btn:focus:active {
    background-color: rgb(255, 255, 255) !important;
    color: var(--gris-600) !important;
    border-width: 1px !important;
    border-color: var(--gris-200) !important;
}

.ch-btn-hoy,
.ch-btn-hoy:hover, .ch-btn-hoy:focus, .ch-btn-hoy:active,
.ch-btn-hoy:focus:hover, .ch-btn-hoy:hover:active, .ch-btn-hoy:focus:active {
    background-color: rgb(255, 255, 255) !important;
    color: var(--gris-800) !important;
    border-width: 1px !important;
    border-color: var(--gris-200) !important;
}

.ch-btn-consultar,
.ch-btn-consultar:hover, .ch-btn-consultar:focus, .ch-btn-consultar:active,
.ch-btn-consultar:focus:hover, .ch-btn-consultar:hover:active, .ch-btn-consultar:focus:active {
    background-color: var(--naranja) !important;
    color: rgb(255, 255, 255) !important;
    border-width: 0 !important;
}

.ch-btn-pdf-informe,
.ch-btn-pdf-informe:hover, .ch-btn-pdf-informe:focus, .ch-btn-pdf-informe:active,
.ch-btn-pdf-informe:focus:hover, .ch-btn-pdf-informe:hover:active, .ch-btn-pdf-informe:focus:active {
    background-color: var(--gris-100) !important;
    color: var(--gris-600) !important;
    border-width: 0 !important;
}

.btn-detalle,
.btn-detalle:hover, .btn-detalle:focus, .btn-detalle:active,
.btn-detalle:focus:hover, .btn-detalle:hover:active, .btn-detalle:focus:active {
    background-color: var(--naranja-suave) !important;
    color: var(--vino) !important;
    border-width: 0 !important;
}

.modal-close,
.modal-close:hover, .modal-close:focus, .modal-close:active,
.modal-close:focus:hover, .modal-close:hover:active, .modal-close:focus:active {
    background-color: var(--gris-100) !important;
    color: var(--gris-500) !important;
    border-width: 0 !important;
}

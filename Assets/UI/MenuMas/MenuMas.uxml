<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements">
    <Style src="MenuMas.uss" />
    <ui:VisualElement name="root-menu-mas" style="flex-grow: 1; align-items: flex-start;">

        <!-- Botón "Más" en la barra -->
        <ui:Button name="btn-mas" text="Más ▾" class="btn-barra-mas" />

        <!-- Bloqueador full-screen para detectar clic fuera -->
        <ui:VisualElement name="bloqueador-click-fuera" class="bloqueador-click-fuera" style="display: none;" />

        <!-- Panel desplegable -->
        <ui:VisualElement name="panel-desplegable-mas" class="panel-desplegable-mas" style="display: none;">
            <ui:Button name="btn-facturas" text="Facturas" class="item-menu-mas" />
            <ui:Button name="btn-gestion-carta" text="Gestión de carta" class="item-menu-mas" />
            <ui:Button name="btn-panel-turnos" text="Plan de turnos" class="item-menu-mas" />
            <ui:Button name="btn-fichajes" text="Control horario" class="item-menu-mas" />
        </ui:VisualElement>

    </ui:VisualElement>
</UXML>
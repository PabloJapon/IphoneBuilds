<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Fichaje.uss"/>
    <ui:VisualElement name="fichaje-overlay" class="fichaje-overlay">
        <ui:VisualElement class="fichaje-card">
            <ui:VisualElement class="fichaje-header">
                <ui:Label text="Fichaje" class="fichaje-title"/>
                <ui:Label name="live-clock" text="00:00:00" class="header-clock"/>
                <ui:Button name="fichaje-close" text="✕" class="fichaje-close"/>
            </ui:VisualElement>

            <ui:VisualElement name="screen-pin" class="fichaje-screen">
                <ui:Label name="restaurant-name" text="RESTAURANTE" class="pin-restaurant-name"/>
                <ui:Label name="pin-error" class="pin-error"/>
                <ui:VisualElement name="pin-dots" class="pin-dots"/>
                <ui:VisualElement class="keypad">
                    <ui:Button name="key-1" text="1" class="key"/>
                    <ui:Button name="key-2" text="2" class="key"/>
                    <ui:Button name="key-3" text="3" class="key"/>
                    <ui:Button name="key-4" text="4" class="key"/>
                    <ui:Button name="key-5" text="5" class="key"/>
                    <ui:Button name="key-6" text="6" class="key"/>
                    <ui:Button name="key-7" text="7" class="key"/>
                    <ui:Button name="key-8" text="8" class="key"/>
                    <ui:Button name="key-9" text="9" class="key"/>
                    <ui:Button name="key-del" text="⌫" class="key key-del"/>
                    <ui:Button name="key-0" text="0" class="key"/>
                    <ui:Button name="key-enter" text="Entrar" class="key key-enter"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="screen-aviso" class="fichaje-screen" style="display: none;">
                <ui:Label text="Registro de jornada laboral" class="fichaje-title" style="margin-bottom: 16px; -unity-text-align: middle-center;"/>
                <ui:Label text="Este sistema registra tu hora de entrada y salida mediante tu código personal. El registro es obligatorio por ley (art. 34.9 del Estatuto de los Trabajadores).&#10;&#10;Si olvidas fichar la salida, el sistema te lo indicará en tu siguiente entrada y podrás proponer la hora real. Un responsable la revisará y aprobará antes de quedar registrada." class="incidencia-text"/>
                <ui:Button name="aviso-aceptar" text="Entendido" class="key key-enter incidencia-confirm-btn"/>
            </ui:VisualElement>

            <ui:VisualElement name="screen-incidencia" class="fichaje-screen" style="display: none;">
                <ui:Label name="incidencia-text" text="" class="incidencia-text"/>
                <ui:VisualElement class="stepper-row">
                    <ui:VisualElement class="stepper-group">
                        <ui:Button name="incidencia-hour-up" text="▲" class="stepper-btn"/>
                        <ui:Label name="incidencia-hour-label" text="Hora" class="stepper-caption"/>
                        <ui:Button name="incidencia-hour-down" text="▼" class="stepper-btn"/>
                    </ui:VisualElement>
                    <ui:Label name="incidencia-time" text="20:00" class="incidencia-time"/>
                    <ui:VisualElement class="stepper-group">
                        <ui:Button name="incidencia-min-up" text="▲" class="stepper-btn"/>
                        <ui:Label name="incidencia-min-label" text="Min" class="stepper-caption"/>
                        <ui:Button name="incidencia-min-down" text="▼" class="stepper-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="incidencia-confirm" text="Confirmar" class="key key-enter incidencia-confirm-btn"/>
                <ui:Button name="incidencia-skip" text="Corregir más tarde" class="link-btn"/>
            </ui:VisualElement>

            <ui:VisualElement name="screen-confirm" class="fichaje-screen" style="display: none;">
                <ui:VisualElement class="stamp-wrap">
                    <ui:Label name="stamp-icon" text="✓" class="stamp"/>
                    <ui:Label name="stamp-type" text="Entrada" class="stamp-type"/>
                    <ui:Label name="stamp-employee" text="—" class="stamp-employee"/>
                    <ui:Label name="stamp-time" text="" class="stamp-time"/>
                    <ui:Label name="return-label" text="Volviendo al inicio…" class="return-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
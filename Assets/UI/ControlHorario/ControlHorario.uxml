<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ControlHorario/ControHorario.uss?fileID=7433441132597879392&amp;guid=463989f945166a644b086b886f13546d&amp;type=3#ControHorario"/>
    <ui:VisualElement name="ch-app" class="ch-app">
        <ui:Label text="Control horario" name="ch-title" class="ch-title"/>
        <ui:Label text="Consulta quien esta trabajando ahora y genera informes de fichajes por empleado y periodo." name="ch-subtitle" class="ch-subtitle"/>
        <ui:VisualElement name="ch-tabs-nav" class="ch-tabs-nav">
            <ui:Button text="Vista diaria" name="ch-tab-btn-dia" class="ch-tab-btn"/>
            <ui:Button text="Informes por periodo" name="ch-tab-btn-informe" class="ch-tab-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="ch-tab-dia" class="ch-tab-panel">
            <ui:VisualElement name="ch-toolbar" class="ch-toolbar">
                <ui:VisualElement name="ch-navbox" class="ch-navbox">
                    <ui:Button text="&lt;" name="ch-btn-dia-prev" class="ch-icon-btn"/>
                    <ui:TextField name="ch-campo-fecha" class="ch-date-field"/>
                    <ui:Button text="&gt;" name="ch-btn-dia-next" class="ch-icon-btn"/>
                    <ui:VisualElement name="ch-divider-dia" class="ch-divider"/>
                    <ui:Button text="Hoy" name="ch-btn-hoy" class="ch-btn-hoy"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ch-stat-grid" class="ch-stat-grid">
                <ui:VisualElement name="ch-stat-trabajando" class="ch-stat-box ch-dot-working">
                    <ui:Label text="-" name="ch-stat-trabajando-value" class="ch-stat-value"/>
                    <ui:Label text="Trabajando ahora" class="ch-stat-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="ch-stat-horas" class="ch-stat-box ch-dot-out">
                    <ui:Label text="-" name="ch-stat-horas-value" class="ch-stat-value"/>
                    <ui:Label text="Horas trabajadas (dia)" class="ch-stat-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="ch-stat-incompletos" class="ch-stat-box ch-dot-warning">
                    <ui:Label text="-" name="ch-stat-incompletos-value" class="ch-stat-value"/>
                    <ui:Label text="Turnos sin cerrar" class="ch-stat-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="ch-stat-sinfichar" class="ch-stat-box">
                    <ui:Label text="-" name="ch-stat-sinfichar-value" class="ch-stat-value"/>
                    <ui:Label text="Sin fichar hoy" class="ch-stat-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="ch-table-wrap" mode="Vertical" class="ch-table-wrap">
                <ui:VisualElement name="ch-table" class="ch-table">
                    <ui:VisualElement name="ch-table-head" class="ch-table-row ch-table-head">
                        <ui:Label text="Empleado" class="ch-th ch-col-empleado"/>
                        <ui:Label text="Estado" class="ch-th ch-col-estado"/>
                        <ui:Label text="Entrada / salida" class="ch-th ch-col-turnos"/>
                        <ui:Label text="Horas" class="ch-th ch-col-horas"/>
                        <ui:Label text="" class="ch-th ch-col-accion"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ch-tabla-body" class="ch-tabla-body"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="ch-tab-informe" class="ch-tab-panel">
            <ui:VisualElement name="ch-filtros-card" class="ch-filtros-card">
                <ui:VisualElement name="ch-filtros-row" class="ch-filtros-row">
                    <ui:VisualElement class="ch-filtro-group">
                        <ui:Label text="TRABAJADOR" class="ch-filtro-label"/>
                        <ui:DropdownField name="ch-ir-empleado" class="ch-select-input"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ch-filtro-group">
                        <ui:Label text="PERIODO" class="ch-filtro-label"/>
                        <ui:VisualElement name="ch-seg-control" class="ch-seg-control">
                            <ui:Button text="Mes completo" name="ch-seg-mes" class="ch-seg-btn"/>
                            <ui:Button text="Rango de fechas" name="ch-seg-rango" class="ch-seg-btn"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="ch-grupo-mes" class="ch-filtro-group">
                        <ui:Label text="MES (AAAA-MM)" class="ch-filtro-label"/>
                        <ui:TextField name="ch-ir-mes" class="ch-select-input ch-month-field"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ch-grupo-desde" class="ch-filtro-group">
                        <ui:Label text="DESDE (AAAA-MM-DD)" class="ch-filtro-label"/>
                        <ui:TextField name="ch-ir-desde" class="ch-select-input ch-date-field"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ch-grupo-hasta" class="ch-filtro-group">
                        <ui:Label text="HASTA (AAAA-MM-DD)" class="ch-filtro-label"/>
                        <ui:TextField name="ch-ir-hasta" class="ch-select-input ch-date-field"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ch-filtro-group">
                        <ui:Label text=" " class="ch-filtro-label"/>
                        <ui:Button text="Consultar" name="ch-btn-consultar" class="ch-btn-consultar"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="" name="ch-informe-error" class="ch-informe-error"/>
            </ui:VisualElement>
            <ui:VisualElement name="ch-informe-resultado">
                <ui:VisualElement name="ch-informe-header" class="ch-informe-header">
                    <ui:VisualElement>
                        <ui:Label text="-" name="ch-informe-titulo" class="ch-informe-titulo"/>
                        <ui:Label text="-" name="ch-informe-sub" class="ch-informe-sub"/>
                    </ui:VisualElement>
                    <ui:Button text="Descargar informe (CSV)" name="ch-btn-pdf-informe" class="ch-btn-pdf-informe"/>
                </ui:VisualElement>
                <ui:VisualElement name="ch-ir-stat-grid" class="ch-stat-grid">
                    <ui:VisualElement class="ch-stat-box ch-dot-out">
                        <ui:Label text="-" name="ch-ir-stat-horas" class="ch-stat-value"/>
                        <ui:Label text="Horas trabajadas" class="ch-stat-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ch-stat-box">
                        <ui:Label text="-" name="ch-ir-stat-dias" class="ch-stat-value"/>
                        <ui:Label text="Dias trabajados" class="ch-stat-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ch-stat-box">
                        <ui:Label text="-" name="ch-ir-stat-media" class="ch-stat-value"/>
                        <ui:Label text="Media horas / dia" class="ch-stat-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ch-stat-box">
                        <ui:Label text="-" name="ch-ir-stat-turnos" class="ch-stat-value"/>
                        <ui:Label text="Turnos registrados" class="ch-stat-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="ch-ir-table-wrap" mode="Vertical" class="ch-table-wrap">
                    <ui:VisualElement class="ch-table">
                        <ui:VisualElement name="ch-ir-table-head" class="ch-table-row ch-table-head">
                            <ui:Label text="Fecha" class="ch-th ch-col-fecha"/>
                            <ui:Label text="Empleado" name="ch-ir-th-empleado" class="ch-th ch-col-empleado"/>
                            <ui:Label text="Entrada" class="ch-th ch-col-entrada"/>
                            <ui:Label text="Salida" class="ch-th ch-col-salida"/>
                            <ui:Label text="Horas" class="ch-th ch-col-horas"/>
                            <ui:Label text="" class="ch-th ch-col-accion"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="ch-ir-tabla-body" class="ch-tabla-body"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:Label text="Elige un trabajador y un periodo, y pulsa Consultar para ver el informe." name="ch-informe-vacio" class="ch-empty"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ch-modal-overlay" class="modal-overlay">
        <ui:VisualElement name="ch-modal-box" class="modal-box">
            <ui:VisualElement class="modal-header">
                <ui:VisualElement>
                    <ui:Label text="Empleado" name="ch-md-nombre" class="modal-header-title"/>
                    <ui:Label text="Fecha" name="ch-md-fecha" class="modal-header-sub"/>
                </ui:VisualElement>
                <ui:Button text="X" name="ch-modal-close" class="modal-close"/>
            </ui:VisualElement>
            <ui:ScrollView name="ch-md-body" class="modal-body"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

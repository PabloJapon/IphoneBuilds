.reservas-view {
    flex-grow: 1;
    padding: 32px 40px;
    margin-top: 90px;
    background-color: rgb(245, 245, 247);
    position: relative;
    -unity-font-definition: resource("Fonts/Poppins SDF 1");
}

.header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.page-title {
    font-size: 32px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(30, 30, 34);
    margin-right: 24px;
}

.stats-row {
    flex-direction: row;
    flex-grow: 1;
}

.stat-pill {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(225, 225, 228);
    border-radius: 20px;
    padding: 10px 20px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(60, 60, 65);
    margin-right: 12px;
}

.stat-pill--info {
    background-color: rgb(230, 240, 255);
    color: rgb(30, 90, 180);
    border-width: 0;
}

.btn-primary {
    background-color: rgb(245, 168, 60);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 8px;
    padding: 14px 26px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
}

.btn-secondary {
    background-color: rgb(240, 240, 242);
    color: rgb(60, 60, 65);
    border-width: 0;
    border-radius: 8px;
    padding: 14px 26px;
    margin-right: 10px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
}

.toolbar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

/* ---------- Segmented control (new primary navigation) ---------- */

.segmented-control {
    flex-direction: row;
    margin-right: 16px;
}

.segment {
    border-radius: 8px;
    padding: 14px 22px;
    margin-right: 8px;
    font-size: 19px;
    background-color: rgb(255, 255, 255);
    color: rgb(90, 90, 96);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    -unity-font-style: bold; letter-spacing: -6px;
}

.segment--active {
    background-color: rgb(164, 35, 63);
    color: rgb(255, 255, 255);
    border-width: 0;
}

/* ---------- Date nav (only visible in "Por fecha") ---------- */

.controles-fecha {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.date-nav {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.date-nav__arrow {
    width: 40px;
    height: 40px;
    padding: 0;
    font-size: 22px;
    -unity-font-style: bold; letter-spacing: -6px;
    background-color: rgb(255, 255, 255);
    color: rgb(60, 60, 65);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    border-radius: 8px;
    -unity-text-align: middle-center;
}

.date-nav__label {
    min-width: 120px;
    -unity-text-align: middle-center;
    font-size: 19px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(30, 30, 34);
    padding: 0 10px;
}

.search-container {
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    border-radius: 8px;
    padding: 0 12px;
    width: 240px;
    height: 44px;
}

.search-icon {
    width: 16px;
    height: 16px;
    margin-right: 3px;
    margin-top: 4px;
    position: relative;
}

.search-icon__circle {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: rgb(150, 150, 155);
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    left: 0;
    top: 0;
}

.search-icon__handle {
    width: 2px;
    height: 6px;
    background-color: rgb(150, 150, 155);
    position: absolute;
    left: 7px;
    top: 9px;
    transform-origin: 0% 0%;
    rotate: -45deg;
}

.search-field {
    flex-grow: 1;
    font-size: 18px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.search-field > .unity-base-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin: 0;
}

.filter-chips {
    flex-direction: row;
    margin-left: 16px;
}

.chip {
    border-radius: 20px;
    padding: 10px 20px;
    margin-right: 8px;
    font-size: 19px;
    background-color: rgb(255, 255, 255);
    color: rgb(90, 90, 96);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
}

.chip--active {
    background-color: rgb(40, 40, 44);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.content-row {
    flex-direction: row;
    flex-grow: 1;
}

.list-column {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(225, 225, 228);
    overflow: hidden;
}

.list-column--full {
    margin-right: 0;
}

.reservas-list {
    flex-grow: 1;
}

.list-state-message {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(150, 150, 155);
    padding: 60px 20px;
    white-space: normal;
}

.reserva-row {
    flex-direction: row;
    align-items: center;
    padding: 0px 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(235, 235, 238);
    border-left-width: 4px;
    border-left-color: transparent;
    min-height: 76px;
    background-color: rgba(0, 0, 0, 0);
}

.reserva-row:hover {
    background-color: rgba(0, 0, 0, 0);
}

.reserva-row--header {
    background-color: rgb(250, 250, 251);
    padding: 16px 24px;
    min-height: 0;
    flex-shrink: 0;
    border-left-width: 0;
}

.reserva-row--header:hover {
    background-color: rgb(250, 250, 251);
}

.reserva-row--header Label {
    font-size: 20px;
    color: rgb(130, 130, 136);
    -unity-font-style: bold; letter-spacing: -6px;
}

.reserva-row--pendiente {
    border-left-color: rgb(245, 168, 60);
}

.reserva-row--confirmada {
    border-left-color: rgb(60, 180, 100);
}

.reserva-row--cancelada {
    border-left-color: rgb(190, 40, 40);
}

.reserva-row--selected {
    background-color: rgb(253, 243, 231);
}

.reserva-row--selected:hover {
    background-color: rgb(253, 243, 231);
}

.col-hora { width: 100px; font-size: 20px; -unity-font-style: bold; letter-spacing: -6px; color: rgb(40, 40, 44); }
.col-fecha { width: 90px; font-size: 18px; color: rgb(120, 120, 125); }
.col-nombre { flex-grow: 1; font-size: 20px; color: rgb(40, 40, 44); }
.col-personas { width: 145px; font-size: 20px; color: rgb(90, 90, 96); }
.col-estado { width: 265px; }

.row-acciones-rapidas {
    flex-direction: row;
    width: 90px;
    justify-content: flex-end;
}

.btn-accion-rapida {
    width: 34px;
    height: 34px;
    padding: 0;
    margin-left: 8px;
    border-radius: 8px;
    font-size: 18px;
    -unity-font-style: bold; letter-spacing: -6px;
    -unity-text-align: middle-center;
}

.btn-accion-confirmar {
    background-color: rgb(222, 245, 227);
    color: rgb(30, 130, 76);
    border-width: 0;
}

.btn-accion-cancelar {
    background-color: rgb(255, 225, 225);
    color: rgb(190, 40, 40);
    border-width: 0;
}

.estado-badge {
    padding: 8px 18px;
    border-radius: 10px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    -unity-text-align: middle-center;
    max-width: 160px;
}

.estado--confirmada {
    background-color: rgb(222, 245, 227);
    color: rgb(30, 130, 76);
}

.estado--pendiente {
    background-color: rgb(255, 240, 214);
    color: rgb(180, 120, 10);
}

.estado--cancelada {
    background-color: rgb(255, 225, 225);
    color: rgb(190, 40, 40);
}

.detail-urgencia {
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(190, 40, 40);
    background-color: rgb(255, 225, 225);
    padding: 6px 12px;
    border-radius: 8px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.detail-nombre {
    font-size: 24px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(30, 30, 34);
    margin-bottom: 16px;
}

.detail-meta {
    font-size: 20px;
    color: rgb(80, 80, 85);
    margin-bottom: 10px;
}

.detail-notas {
    font-size: 20px;
    color: rgb(40, 40, 44);
    white-space: normal;
}

.detail-actions {
    flex-direction: row;
    margin-top: 20px;
}

.btn-confirm {
    background-color: rgb(30, 130, 76);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 8px;
    padding: 12px 20px;
    margin-right: 10px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    flex-grow: 1;
}

.btn-cancel {
    background-color: rgb(255, 255, 255);
    color: rgb(190, 40, 40);
    border-width: 1px;
    border-color: rgb(190, 40, 40);
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    flex-grow: 1;
}

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(20, 20, 24, 0.45);
    align-items: center;
    justify-content: center;
}

.modal-box {
    width: 700px;
    background-color: rgb(255, 255, 255);
    border-radius: 14px;
    padding: 32px;
}

.detail-modal-box {
    width: 700px;
    position: relative;
    padding-top: 36px;
}

.detail-modal-box .modal-close {
    position: absolute;
    top: 24px;
    right: 24px;
    margin-bottom: 0;
}

.detail-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-right: 50px;
}

.detail-header .detail-nombre {
    margin-bottom: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.detail-estado-badge {
    flex-shrink: 0;
    margin-left: 12px;
}

.detail-info-card {
    background-color: rgb(250, 250, 251);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(235, 235, 238);
    padding: 4px 18px;
    margin-bottom: 16px;
}

.detail-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
}

.detail-info-label {
    font-size: 18px;
    color: rgb(140, 140, 145);
}

.detail-info-value {
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(40, 40, 44);
}

.detail-info-divider {
    height: 1px;
    background-color: rgb(235, 235, 238);
}

.detail-notas-card {
    background-color: rgb(250, 250, 251);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(235, 235, 238);
    padding: 14px 18px;
    margin-bottom: 16px;
}

.detail-notas-card .detail-info-label {
    margin-bottom: 6px;
}

.modal-close {
    align-self: flex-end;
    width: 32px;
    height: 32px;
    background-color: rgb(240, 240, 242);
    color: rgb(90, 90, 96);
    border-width: 0;
    border-radius: 16px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    padding: 0;
    margin-bottom: 12px;
}

.modal-title {
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(30, 30, 34);
    margin-bottom: 20px;
}

.modal-field {
    margin-bottom: 14px;
}

.modal-label {
    font-size: 20px;
    color: rgb(120, 120, 125);
    margin-bottom: 6px;
}

.modal-field TextField {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    border-radius: 8px;
    font-size: 20px;
    min-width: 0;
    width: 100%;
}

.modal-field TextField > .unity-base-text-field__input {
    font-size: 20px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    padding: 10px 14px;
    color: rgb(40, 40, 44);
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.modal-field TextField:focus {
    border-color: rgb(245, 168, 60);
}

.modal-field-row {
    flex-direction: row;
}

.modal-field-row > .modal-field {
    flex: 1 1 0;
    min-width: 0;
}

.modal-field-row > .modal-field:first-child {
    margin-right: 10px;
}

.hora-picker-btn {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    border-radius: 8px;
    font-size: 20px;
    color: rgb(40, 40, 44);
    padding: 10px 14px;
    -unity-text-align: middle-left;
}

.hora-picker-box {
    width: 460px;
}

.date-picker-box {
    width: 640px;
    padding: 24px;
}

.hora-picker-scroll {
    max-height: 320px;
}

.hora-picker-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.hora-chip {
    width: 92px;
    margin: 0 8px 8px 0;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    border-radius: 8px;
    font-size: 18px;
    color: rgb(60, 60, 65);
    padding: 10px 0;
    -unity-text-align: middle-center;
}

.hora-chip--active {
    background-color: rgb(164, 35, 63);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.cal-cabecera {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.cal-mes-label {
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(30, 30, 34);
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.cal-dias-semana {
    flex-direction: row;
    margin-bottom: 8px;
}

.cal-dia-semana-label {
    width: 76px;
    margin-right: 8px;
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(120, 120, 125);
}

.cal-grid-fechas {
    flex-direction: row;
    flex-wrap: wrap;
}

.cal-day-chip {
    width: 76.5px;
    height: 54px;
    margin: 0 8px 8px 0;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    border-radius: 8px;
    font-size: 18px;
    -unity-font-style: bold; letter-spacing: -6px;
    color: rgb(40, 40, 44);
    -unity-text-align: middle-center;
}

.cal-day-chip--empty {
    visibility: hidden;
}

.cal-day-chip--selected {
    background-color: rgb(164, 35, 63);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.cal-day-chip:disabled {
    background-color: rgb(250, 250, 251) !important;
    border-color: rgb(235, 235, 238) !important;
    color: rgb(200, 200, 204) !important;
}

.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.toast {
    position: absolute;
    bottom: 32px;
    right: 40px;
    background-color: rgb(40, 40, 44);
    color: rgb(255, 255, 255);
    padding: 14px 22px;
    border-radius: 10px;
    font-size: 20px;
    -unity-font-style: bold; letter-spacing: -6px;
}

.toast--success {
    background-color: rgb(30, 130, 76);
}

.toast--error {
    background-color: rgb(190, 40, 40);
}

/* ---------- Custom thin scrollbar ---------- */

.unity-scroller--vertical {
    width: 10px;
    margin-left: 4px;
}

.unity-scroller--vertical .unity-scroller__low-button,
.unity-scroller--vertical .unity-scroller__high-button {
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    opacity: 0;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(210, 210, 214);
    border-radius: 6px;
    border-width: 0;
    width: 6px;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover,
.unity-scroller--vertical .unity-base-slider__dragger:active,
.unity-scroller--vertical .unity-base-slider__dragger:focus {
    background-color: rgb(210, 210, 214);
    border-width: 0;
}

/* ---------- Hover/focus lock — proven fix, do not remove ---------- */

Button,
Button:hover,
Button:focus,
Button:active,
Button:focus:hover,
Button:hover:active,
Button:focus:active {
    background-image: none !important;
    opacity: 1 !important;
    scale: 1 1 !important;
    transition-duration: 0s !important;
}

.btn-primary,
.btn-primary:hover, .btn-primary:focus, .btn-primary:active,
.btn-primary:focus:hover, .btn-primary:hover:active, .btn-primary:focus:active {
    background-color: rgb(245, 168, 60) !important;
    border-width: 0 !important;
}

.btn-secondary,
.btn-secondary:hover, .btn-secondary:focus, .btn-secondary:active,
.btn-secondary:focus:hover, .btn-secondary:hover:active, .btn-secondary:focus:active {
    background-color: rgb(240, 240, 242) !important;
    border-width: 0 !important;
}

.segment,
.segment:hover, .segment:focus, .segment:active,
.segment:focus:hover, .segment:hover:active, .segment:focus:active {
    background-color: rgb(255, 255, 255) !important;
    border-width: 1px !important;
    border-color: rgb(220, 220, 224) !important;
}

.segment--active,
.segment--active:hover, .segment--active:focus, .segment--active:active,
.segment--active:focus:hover, .segment--active:hover:active, .segment--active:focus:active {
    background-color: rgb(164, 35, 63) !important;
    border-width: 0 !important;
}

.date-nav__arrow,
.date-nav__arrow:hover, .date-nav__arrow:focus, .date-nav__arrow:active,
.date-nav__arrow:focus:hover, .date-nav__arrow:hover:active, .date-nav__arrow:focus:active {
    background-color: rgb(255, 255, 255) !important;
    border-width: 1px !important;
    border-color: rgb(220, 220, 224) !important;
}

.chip,
.chip:hover, .chip:focus, .chip:active,
.chip:focus:hover, .chip:hover:active, .chip:focus:active {
    background-color: rgb(255, 255, 255) !important;
    border-width: 1px !important;
    border-color: rgb(220, 220, 224) !important;
}

.chip--active,
.chip--active:hover, .chip--active:focus, .chip--active:active,
.chip--active:focus:hover, .chip--active:hover:active, .chip--active:focus:active {
    background-color: rgb(40, 40, 44) !important;
    border-width: 0 !important;
}

.btn-confirm,
.btn-confirm:hover, .btn-confirm:focus, .btn-confirm:active,
.btn-confirm:focus:hover, .btn-confirm:hover:active, .btn-confirm:focus:active {
    background-color: rgb(30, 130, 76) !important;
    border-width: 0 !important;
}

.btn-cancel,
.btn-cancel:hover, .btn-cancel:focus, .btn-cancel:active,
.btn-cancel:focus:hover, .btn-cancel:hover:active, .btn-cancel:focus:active {
    background-color: rgb(255, 255, 255) !important;
    border-width: 1px !important;
    border-color: rgb(190, 40, 40) !important;
}

.btn-accion-confirmar,
.btn-accion-confirmar:hover, .btn-accion-confirmar:focus, .btn-accion-confirmar:active,
.btn-accion-confirmar:focus:hover, .btn-accion-confirmar:hover:active, .btn-accion-confirmar:focus:active {
    background-color: rgb(222, 245, 227) !important;
    border-width: 0 !important;
}

.btn-accion-cancelar,
.btn-accion-cancelar:hover, .btn-accion-cancelar:focus, .btn-accion-cancelar:active,
.btn-accion-cancelar:focus:hover, .btn-accion-cancelar:hover:active, .btn-accion-cancelar:focus:active {
    background-color: rgb(255, 225, 225) !important;
    border-width: 0 !important;
}

.modal-close,
.modal-close:hover, .modal-close:focus, .modal-close:active,
.modal-close:focus:hover, .modal-close:hover:active, .modal-close:focus:active {
    background-color: rgb(240, 240, 242) !important;
    border-width: 0 !important;
}

.hora-picker-btn,
.hora-picker-btn:hover, .hora-picker-btn:focus, .hora-picker-btn:active,
.hora-picker-btn:focus:hover, .hora-picker-btn:hover:active, .hora-picker-btn:focus:active {
    background-color: rgb(255, 255, 255) !important;
    border-width: 1px !important;
    border-color: rgb(220, 220, 224) !important;
}

.personas-stepper {
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    border-radius: 8px;
    height: 44px;
    justify-content: space-between;
    padding: 0 4px;
}

.stepper-btn {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background-color: rgb(255, 255, 255);
    color: rgb(40, 40, 44);
    border-width: 1px;
    border-color: rgb(220, 220, 224);
    font-size: 22px;
    -unity-font-style: bold; letter-spacing: -6px;
    padding: 0;
    -unity-text-align: middle-center;
}

.stepper-btn:disabled {
    color: rgb(200, 200, 204);
    background-color: rgb(245, 245, 247);
    border-color: rgb(235, 235, 238);
}

.stepper-valor {

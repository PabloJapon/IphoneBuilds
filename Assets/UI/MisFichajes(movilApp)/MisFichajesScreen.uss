.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(246, 247, 250);
}

/* ---------- Cabecera ---------- */

.header {
    background-color: rgb(102, 153, 255);
    padding: 56px 48px 60px 48px;
}

.header-top-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 36px;
}

.back-button {
    width: 80px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 75px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.header-title {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 55px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 8px;
}

.header-spacer {
    width: 80px;
}

.week-nav-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.nav-arrow {
    width: 68px;
    height: 68px;
    border-width: 0;
    border-radius: 36px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 75px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    background-color: rgba(20, 24, 34, 0);
}

.week-range-label {
    flex-grow: 1;
    color: rgba(255, 255, 255, 0.92);
    font-size: 45px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---------- Lista de días ---------- */

.day-list {
    flex-grow: 1;
    padding: 40px 32px;
}

.day-list > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-direction: column;
}

.day-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    border-width: 1px;
    border-color: rgba(20, 24, 34, 0.05);
    border-left-width: 6px;
    border-left-color: rgba(20, 24, 34, 0.05);
    padding: 32px 40px;
    margin-bottom: 36px;
}

.day-row--today {
    background-color: rgb(240, 244, 255);
    border-left-width: 8px;
    border-left-color: rgb(102, 153, 255);
}

.day-row--free {
    background-color: rgb(250, 250, 252);
}

.day-info {
    width: 150px;
    align-items: center;
    margin-right: 40px;
}

.day-weekday {
    font-size: 26px;
    color: rgb(158, 164, 176);
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.day-date {
    font-size: 54px;
    color: rgb(28, 31, 38);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.day-row--today .day-weekday,
.day-row--today .day-date {
    color: rgb(102, 153, 255);
}

.day-row--free .day-weekday,
.day-row--free .day-date {
    color: rgb(196, 201, 209);
}

.day-shifts {
    flex-grow: 1;
    flex-direction: column;
}

.shift-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.shift-time {
    font-size: 36px;
    color: rgb(28, 31, 38);
    -unity-font-style: bold;
    margin-right: 16px;
}

.tipo-tag {
    font-size: 36px;
    border-radius: 16px;
    padding: 6px 16px;
    -unity-font-style: bold;
}

.tipo-tag--entrada {
    color: rgb(56, 161, 105);
    background-color: rgb(224, 245, 232);
}

.tipo-tag--salida {
    color: rgb(220, 75, 75);
    background-color: rgb(252, 228, 228);
}

.tipo-tag--pausa {
    color: rgb(217, 145, 44);
    background-color: rgb(253, 237, 214);
}

.shift-free {
    font-size: 36px;
    color: rgb(196, 201, 209);
}

/* ---------- Estado ---------- */

.status-label {
    color: rgb(120, 126, 138);
    font-size: 32px;
    -unity-text-align: middle-center;
    padding: 40px;
}


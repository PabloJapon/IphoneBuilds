<?xml version="1.0" encoding="utf-8"?>
<!--
  DishCardItem.uxml
  Plantilla de UNA tarjeta de plato. No se usa directamente en
  pantalla: se instancia por código, una vez por cada plato,
  equivalente a la función dishCardHTML() del original.

  Uso típico en C#:

    [SerializeField] VisualTreeAsset dishCardTemplate;

    VisualElement BuildDishCard(Dish d) {
        var card = dishCardTemplate.CloneTree();

        card.Q<Label>("dish-name").text = d.Name;
        card.Q<Label>("dish-price").text = FormatPrice(d.Price);
        card.Q<Label>("dish-desc").text = d.Description;

        var thumb = card.Q<VisualElement>("dish-thumb");
        if (!string.IsNullOrEmpty(d.ImageUrl))
            StartCoroutine(LoadThumb(d.ImageUrl, thumb)); // asigna style.backgroundImage
        else
            card.Q<VisualElement>("dish-card").AddToClassList("no-img");

        var vegBadge = card.Q<Label>("badge-veg");
        vegBadge.style.display = d.IsVeg ? DisplayStyle.Flex : DisplayStyle.None;

        card.RegisterCallback<ClickEvent>(evt => OpenSheet(d));
        return card;
    }

  Nota sobre la imagen: ui:VisualElement no tiene atributo "src"
  como <img>; hay que descargarla (UnityWebRequestTexture) y
  asignarla en C# con:
    thumb.style.backgroundImage = new StyleBackground(texture2D);
  Si prefieres un componente con más soporte nativo de imagen
  (placeholder, escalado, etc.) puedes sustituir este
  VisualElement por un <ui:Image scale-mode="ScaleAndCrop" />.
-->
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    editor-extension-mode="False">

    <Style src="GastraliMenu.uss" />

    <ui:VisualElement name="dish-card" class="dish-card">

        <ui:VisualElement name="dish-thumb" class="dish-thumb" />

        <ui:VisualElement name="dish-body" class="dish-body">

            <ui:VisualElement class="dish-top">
                <ui:Label name="dish-name" text="Nombre del plato" class="dish-name" />
                <ui:Label name="dish-price" text="0,00 €" class="dish-price" />
            </ui:VisualElement>

            <ui:Label name="dish-desc" text="Descripción del plato." class="dish-desc" />

            <ui:VisualElement name="dish-badges" class="dish-badges">
                <ui:Label name="badge-veg" text="VEGETARIANO" class="badge veg" style="display: none;" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>

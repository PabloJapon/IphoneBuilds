<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Reservas/Reservas.uss?fileID=7433441132597879392&amp;guid=33536257fe578df4c82a366c94e3abc7&amp;type=3#Reservas"/>
    <ui:VisualElement name="reservas-view" class="reservas-view">
        <ui:VisualElement class="header-row">
            <ui:Label text="Reservas" class="page-title"/>
            <ui:VisualElement class="stats-row">
                <ui:Label name="stat-total" text="" class="stat-pill"/>
                <ui:Label name="stat-proxima" text="" class="stat-pill stat-pill--info" style="display: none;"/>
            </ui:VisualElement>
            <ui:Button name="btn-nueva" text="+ Nueva reserva" class="btn-primary"/>
        </ui:VisualElement>
        <ui:VisualElement class="toolbar-row">
            <ui:VisualElement class="segmented-control">
                <ui:Button name="btn-tab-pendientes" text="Pendientes" class="segment"/>
                <ui:Button name="btn-tab-fecha" text="Por fecha" class="segment"/>
            </ui:VisualElement>
            <ui:VisualElement name="date-nav-wrap" class="date-nav">
                <ui:Button name="btn-dia-anterior" text="‹" class="date-nav__arrow"/>
                <ui:Label name="label-fecha" text="Hoy" class="date-nav__label"/>
                <ui:Button name="btn-dia-siguiente" text="›" class="date-nav__arrow"/>
            </ui:VisualElement>
            <ui:VisualElement name="search-container" class="search-container">
                <ui:VisualElement class="search-icon">
                    <ui:VisualElement class="search-icon__circle"/>
                    <ui:VisualElement class="search-icon__handle"/>
                </ui:VisualElement>
                <ui:TextField name="search-field" class="search-field"/>
            </ui:VisualElement>
            <ui:VisualElement name="filtro-chips-wrap" class="filter-chips">
                <ui:Button name="chip-todas" text="Todas" class="chip chip--active"/>
                <ui:Button name="chip-confirmadas" text="Confirmadas" class="chip"/>
                <ui:Button name="chip-pendientes" text="Pendientes" class="chip"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="content-row">
            <ui:VisualElement class="list-column list-column--full">
                <ui:VisualElement class="reserva-row reserva-row--header">
                    <ui:Label text="Hora" class="col-hora"/>
                    <ui:Label name="col-fecha-header" text="Fecha" class="col-fecha"/>
                    <ui:Label text="Cliente" class="col-nombre"/>
                    <ui:Label text="Personas" class="col-personas"/>
                    <ui:Label text="Estado" class="col-estado"/>
                </ui:VisualElement>
                <ui:ListView name="reservas-list" fixed-item-height="76" show-border="false" class="reservas-list"/>
                <ui:Label name="list-state" class="list-state-message" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="detail-modal-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-box detail-modal-box">
                <ui:VisualElement class="detail-header">
                    <ui:Label name="detail-nombre" class="detail-nombre"/>
                    <ui:Label name="detail-estado" class="estado-badge detail-estado-badge"/>
                </ui:VisualElement>
                <ui:Label name="detail-urgencia" class="detail-urgencia" style="display: none;"/>
                <ui:VisualElement class="detail-info-card">
                    <ui:VisualElement class="detail-info-row">
                        <ui:Label text="Fecha y hora" class="detail-info-label"/>
                        <ui:Label name="detail-fecha-hora" class="detail-info-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="detail-info-divider"/>
                    <ui:VisualElement class="detail-info-row">
                        <ui:Label text="Personas" class="detail-info-label"/>
                        <ui:Label name="detail-personas" class="detail-info-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="detail-info-divider"/>
                    <ui:VisualElement class="detail-info-row">
                        <ui:Label text="Teléfono" class="detail-info-label"/>
                        <ui:Label name="detail-telefono" class="detail-info-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="detail-notas-card">
                    <ui:Label text="Notas" class="detail-info-label"/>
                    <ui:Label name="detail-notas" class="detail-notas"/>
                </ui:VisualElement>
                <ui:Label name="detail-cancelada-msg" text="Esta reserva ha sido cancelada" class="detail-cancelada-msg" style="display: none;"/>
                <ui:VisualElement class="detail-actions">
                    <ui:Button name="btn-editar" text="Editar" class="btn-secondary"/>
                    <ui:Button name="btn-confirmar" text="Confirmar" class="btn-confirm"/>
                    <ui:Button name="btn-cancelar" text="Cancelar" class="btn-cancel"/>
                </ui:VisualElement>
                <ui:Button name="detail-close" text="✕" class="modal-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="modal-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement name="nueva-reserva-modal-box" class="modal-box nueva-reserva-modal-box">
                <ui:Label name="modal-titulo" text="Nueva reserva" class="modal-title"/>
                <ui:Label name="modal-subtitulo" text="" class="modal-subtitulo" style="display: none;"/>
                <ui:VisualElement class="modal-field">
                    <ui:Label text="Nombre" class="modal-label"/>
                    <ui:TextField name="modal-nombre"/>
                </ui:VisualElement>
                <ui:VisualElement class="modal-field-row">
                    <ui:VisualElement class="modal-field">
                        <ui:Label text="Teléfono" class="modal-label"/>
                        <ui:TextField name="modal-telefono"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="modal-field">
                        <ui:Label text="Personas" class="modal-label"/>
                        <ui:VisualElement name="personas-stepper" class="personas-stepper">
                            <ui:Button name="personas-menos" text="−" class="stepper-btn"/>
                            <ui:Label name="personas-valor" text="2" class="stepper-valor"/>
                            <ui:Button name="personas-mas" text="+" class="stepper-btn"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="modal-field-row">
                    <ui:VisualElement class="modal-field" style="flex-grow: 1.6;">
                        <ui:Label text="Fecha" class="modal-label"/>
                        <ui:Button name="modal-fecha-btn" text="" class="hora-picker-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="modal-field">
                        <ui:Label text="Hora" class="modal-label"/>
                        <ui:Button name="modal-hora-btn" text="Elegir hora" class="hora-picker-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="modal-field">
                    <ui:Label text="Notas" class="modal-label"/>
                    <ui:TextField name="modal-notas"/>
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="modal-cancelar" text="Cancelar" class="btn-secondary"/>
                    <ui:Button name="modal-guardar" text="Guardar reserva" class="btn-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hora-picker-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-box hora-picker-box">
                <ui:Label text="Selecciona una hora" class="modal-title"/>
                <ui:ScrollView name="hora-picker-scroll" class="hora-picker-scroll">
                    <ui:VisualElement name="hora-picker-grid" class="hora-picker-grid"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="date-picker-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-box date-picker-box">
                <ui:VisualElement class="cal-cabecera">
                    <ui:Button name="cal-mes-anterior" text="‹" class="date-nav__arrow"/>
                    <ui:Label name="cal-mes-label" text="" class="cal-mes-label"/>
                    <ui:Button name="cal-mes-siguiente" text="›" class="date-nav__arrow"/>
                </ui:VisualElement>
                <ui:VisualElement name="cal-dias-semana" class="cal-dias-semana"/>
                <ui:VisualElement name="cal-grid-fechas" class="cal-grid-fechas"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="toast" class="toast" style="display: none;"/>
    </ui:VisualElement>
</ui:UXML>
<?xml version="1.0" encoding="utf-8"?>
<!--
  GastraliMenu.uxml
  Pantalla principal del menú, adaptada de la webapp original.

  CÓMO ESTÁ ORGANIZADO (léelo antes de tocar nada):
  - "gastrali-root" es el contenedor raíz: aquí viven las custom
    properties (colores/fuentes) definidas en GastraliMenu.uss.
  - "sections" es donde tu código C# debe inyectar, por cada
    sección con platos, un Label de título + N instancias de
    DishCardItem.uxml clonadas (ver ese archivo). Se deja UN
    ejemplo estático (section-example / dish-card-example) solo
    para previsualizar el layout en el UI Builder: bórralo al
    generar contenido real.
  - "sheet" / "sheet-backdrop" = bottom sheet de detalle de
    plato (equivalente a #sheet / #sheetBackdrop del original).
  - "filter-sheet" / "filter-backdrop" = bottom sheet de filtros.
  - "brand-splash" = pantalla de carga inicial con logo.

  LIMITACIÓN IMPORTANTE — toolbar "sticky":
  UI Toolkit no soporta position: sticky. Aquí "toolbar" vive
  dentro del mismo ScrollView que el resto del contenido, así
  que se desplaza junto con él (no queda fija arriba). Si
  necesitas que quede fija:
    1) Saca <VisualElement name="toolbar"> de dentro de
       "main-scroll" y ponlo como hermano, ANTES del ScrollView,
       fuera de él.
    2) Dale a "main-scroll" flex-grow:1 para que ocupe el resto
       del alto disponible.
  No lo dejo así por defecto porque cambia bastante el layout
  visual (la info-card ya no se superpondría igual al hero al
  hacer scroll) — mejor que decidas tú ese trade-off visual.
-->
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    editor-extension-mode="False">

    <Style src="GastraliMenu.uss" />

    <ui:VisualElement name="gastrali-root" class="gastrali-screen" style="flex-grow: 1;">

        <ui:VisualElement name="app-root" class="app-root" style="flex-grow: 1;">

            <ui:ScrollView name="main-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" touch-scroll-behavior="Clamped" style="flex-grow: 1;">

                <!-- ===== Header: hero + tarjeta flotante ===== -->
                <ui:VisualElement name="header-wrap" class="header-wrap">
                    <ui:VisualElement name="hero" class="hero">
                        <ui:VisualElement name="hero-overlay" class="hero-overlay" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="header-spacer" class="header-spacer" />

                <!-- ===== Secciones + platos (equivalente a #sections) ===== -->
                <ui:VisualElement name="sections" class="sections">

                    <!-- EJEMPLO ESTÁTICO — solo para previsualizar layout.
                         Bórralo al poblar con datos reales por código. -->
                    <ui:VisualElement name="section-example" class="section">
                        <ui:Label text="Entrantes" class="section-title font-titulo" />
                        <ui:VisualElement name="dish-list-example" class="dish-list">
                            <ui:VisualElement name="dish-card-example" class="dish-card">
                                <ui:VisualElement name="dish-thumb-example" class="dish-thumb" />
                                <ui:VisualElement name="dish-body-example" class="dish-body">
                                    <ui:VisualElement class="dish-top">
                                        <ui:Label text="Croquetas caseras" class="dish-name" />
                                        <ui:Label text="8,50 €" class="dish-price" />
                                    </ui:VisualElement>
                                    <ui:Label text="Croquetas de jamón ibérico con bechamel cremosa, elaboradas de forma artesanal." class="dish-desc" />
                                    <ui:VisualElement class="dish-badges">
                                        <ui:Label text="VEGETARIANO" class="badge veg" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <ui:Label name="footer-note" text="Menú actualizado en tiempo real" class="footer-note" style="padding-bottom: 70px;" />f

            </ui:ScrollView>

            <ui:VisualElement name="fixed-header" class="fixed-header">

                <ui:VisualElement name="info-card" class="info-card">
                    <ui:Label name="rest-name-label" text="Nombre del restaurante" class="rest-name font-titulo" />
                </ui:VisualElement>

                <ui:VisualElement name="toolbar" class="toolbar">

                    <ui:ScrollView name="menu-tabs-scroll" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                        <ui:VisualElement name="menu-tabs" class="menu-tabs h-scroll-row">
                            <ui:Button name="tab-menu" text="Menú" class="menu-tab active" />
                            <ui:Button name="tab-carta" text="Carta" class="menu-tab" />
                            <ui:Button name="tab-bebidas" text="Bebidas" class="menu-tab" />
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <ui:VisualElement name="section-nav-row" class="section-nav-row">
                        <ui:ScrollView name="section-nav-scroll" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                            <ui:VisualElement name="section-nav" class="section-nav h-scroll-row">
                                <ui:Button name="nav-entrantes" text="Entrantes" class="section-nav-item active" />
                                <ui:Button name="nav-principales" text="Principales" class="section-nav-item" />
                                <ui:Button name="nav-postres" text="Postres" class="section-nav-item" />
                            </ui:VisualElement>
                        </ui:ScrollView>

                        <ui:Button name="filter-chip" class="filter-chip">
                            <ui:VisualElement name="filter-icon" class="filter-icon" />
                            <ui:Label name="filter-count-badge" text="0" class="fcount" style="display: none;" />
                        </ui:Button>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ============================================================
             Vista de Pedido (equivalente a #pedidoView) — placeholder,
             se rellena en el siguiente paso.
             ============================================================ -->
        <ui:VisualElement name="pedido-view" class="view" style="display:none; flex-grow:1;">
            <ui:ScrollView name="pedido-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" style="flex-grow:1;">

                <ui:VisualElement name="pedido-header" class="pedido-header">
                    <ui:Label text="Mi pedido" class="pedido-header-title font-titulo" />
                </ui:VisualElement>

                <ui:VisualElement name="course-toggle-row" class="course-toggle-row">
                    <ui:Label text="Elegir orden de platos (1º, 2º y 3º)" class="course-toggle-label" />
                    <ui:VisualElement name="course-toggle" class="toggle-switch">
                        <ui:VisualElement name="course-toggle-knob" class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="pedido-others" class="pedido-others" style="display:none;" />

                <ui:VisualElement name="pedido-empty" class="pedido-empty">
                    <ui:Label text="Tu pedido está vacío" class="pedido-empty-big font-titulo" />
                    <ui:Label text="Añade platos desde el menú para empezar." class="pedido-empty-sub" />
                </ui:VisualElement>

                <ui:VisualElement name="pedido-list" class="pedido-list" />

                <ui:VisualElement name="pedido-summary" class="pedido-summary" style="display:none;">
                    <ui:VisualElement name="pedido-total-row" class="pedido-total-row">
                        <ui:Label text="Total" class="pedido-total-label" />
                        <ui:Label name="pedido-total-value" text="0,00 €" class="pedido-total-value" />
                    </ui:VisualElement>
                    <ui:Button name="pedido-submit-btn" text="Pedir" class="submit-btn" />
                </ui:VisualElement>

                <ui:VisualElement name="pedido-confirmed" class="pedido-confirmed" style="display:none;">
                    <ui:Label text="Ya pedido en tu mesa" class="pedido-section-title" />
                    <ui:VisualElement name="pedido-confirmed-list" />
                </ui:VisualElement>

                <ui:VisualElement style="height: 80px;" />
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- ============================================================
             Barra de navegación inferior (equivalente a .bottom-nav)
             ============================================================ -->
        <ui:VisualElement name="bottom-nav" class="bottom-nav">
            <ui:Button name="nav-menu" class="nav-item active">
                <ui:VisualElement name="nav-menu-icon" class="nav-icon" />
                <ui:Label text="Menú" class="nav-item-label" />
            </ui:Button>
            <ui:Button name="nav-pedido" class="nav-item">
                <ui:VisualElement name="nav-pedido-icon" class="nav-icon" />
                <ui:Label text="Pedido" class="nav-item-label" />
                <ui:Label name="nav-badge" text="0" class="nav-badge" style="display:none;" />
            </ui:Button>
            <ui:Button name="nav-asistencia" class="nav-item">
                <ui:VisualElement name="nav-asistencia-icon" class="nav-icon" />
                <ui:Label text="Asistencia" class="nav-item-label" />
                <ui:VisualElement name="nav-dot" class="nav-dot" style="display:none;" />
            </ui:Button>
            <ui:Button name="nav-pagar" class="nav-item">
                <ui:VisualElement name="nav-pagar-icon" class="nav-icon" />
                <ui:Label text="Pagar" class="nav-item-label" />
            </ui:Button>
        </ui:VisualElement>

        <!-- ============================================================
             Bottom sheet: detalle de plato (equivalente a #sheet)
             ============================================================ -->
        <ui:VisualElement name="sheet-backdrop" class="sheet-backdrop" />

        <ui:ScrollView name="sheet" class="sheet" vertical-scroller-visibility="Hidden">
            <ui:VisualElement name="sheet-handle" class="sheet-handle" />
            <ui:VisualElement name="sheet-img" class="sheet-img" />
            <ui:VisualElement name="sheet-body" class="sheet-body">

                <ui:VisualElement class="sheet-top">
                    <ui:Label name="sheet-name" text="Nombre del plato" class="sheet-name font-titulo" />
                    <ui:Label name="sheet-price" text="0,00 €" class="sheet-price" />
                </ui:VisualElement>

                <ui:VisualElement name="sheet-badges" class="sheet-badges">
                    <ui:Label name="sheet-badge-veg" text="VEGETARIANO" class="badge veg" />
                </ui:VisualElement>

                <ui:Label name="sheet-desc" text="Descripción del plato." class="sheet-desc" />

                <ui:Label name="allergens-label" text="Alérgenos" class="allergens-label" />
                <ui:VisualElement name="allergens" class="allergens">
                    <!-- Se generan por código, solo los alérgenos presentes (allergenList) -->
                    <ui:Label text="Gluten" class="allergen-chip" />
                    <ui:Label text="Lácteos" class="allergen-chip" />
                    <ui:Label text="Huevos" class="allergen-chip" />
                </ui:VisualElement>

                <!-- Contenedor de grupos de opciones — el controller hace
                     sheetOptions.Clear() y reconstruye esto por cada plato.
                     Los dos grupos de aquí dentro son solo de ejemplo para
                     previsualizar el layout en el UI Builder. -->
                <ui:VisualElement name="sheet-options">

                    <!-- Grupo de opciones — ejemplo tipo "radio" (obligatorio) -->
                    <ui:VisualElement name="option-group-example-radio" class="option-group">
                        <ui:VisualElement class="og-head">
                            <ui:Label text="Elige tu guarnición" class="og-title" />
                            <ui:Label text="Obligatorio" class="og-req required" />
                        </ui:VisualElement>
                        <ui:VisualElement class="og-option">
                            <ui:VisualElement class="og-icon" />
                            <ui:Label text="Patatas fritas" class="og-option-name" />
                        </ui:VisualElement>
                        <ui:VisualElement class="og-option">
                            <ui:VisualElement class="og-icon" />
                            <ui:Label text="Ensalada" class="og-option-name" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Grupo de opciones — ejemplo tipo "checkbox" (opcional, con precio) -->
                    <ui:VisualElement name="option-group-example-checkbox" class="option-group">
                        <ui:VisualElement class="og-head">
                            <ui:Label text="Extras" class="og-title" />
                            <ui:Label text="Opcional" class="og-req optional" />
                        </ui:VisualElement>
                        <ui:VisualElement class="og-option">
                            <ui:VisualElement class="og-icon checkbox" />
                            <ui:Label text="Extra de queso" class="og-option-name" />
                            <ui:Label text="+1,00 €" class="og-option-price" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <ui:VisualElement name="sheet-footer" class="sheet-footer">
                <ui:VisualElement name="qty-control" class="qty-control">
                    <ui:Button name="qty-minus" text="−" class="qty-btn" />
                    <ui:Label name="qty-value" text="1" class="qty-value" />
                    <ui:Button name="qty-plus" text="+" class="qty-btn" />
                </ui:VisualElement>
                <ui:Button name="add-btn" class="add-btn">
                    <ui:Label text="Añadir" class="add-btn-label" />
                    <ui:Label name="add-btn-price" text="0,00 €" class="add-btn-price" />
                </ui:Button>
            </ui:VisualElement>

        </ui:ScrollView>

        <!-- ============================================================
             Bottom sheet: filtros (equivalente a #filterSheet)
             ============================================================ -->
        <ui:VisualElement name="filter-backdrop" class="sheet-backdrop" />

        <ui:ScrollView name="filter-sheet" class="sheet" vertical-scroller-visibility="Hidden">
            <ui:VisualElement name="filter-sheet-handle" class="sheet-handle" />
            <ui:VisualElement class="sheet-body">
                <ui:Label text="Filtrar platos" class="sheet-name font-titulo" style="margin-bottom: 14px;" />

                <ui:VisualElement class="option-group" style="margin-top: 0; padding-top: 0; border-top-width: 0;">
                    <ui:VisualElement class="og-head">
                        <ui:Label text="Dieta" class="og-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="f-veg" class="og-option">
                        <ui:VisualElement class="og-icon checkbox" />
                        <ui:Label text="Solo vegetariano" class="og-option-name" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="option-group">
                    <ui:VisualElement class="og-head">
                        <ui:Label text="Excluir alérgenos" class="og-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="f-allergens">
                        <!-- Se generan las 14 filas por código (constante ALLERGENS
                             del original), se dejan 2 de ejemplo -->
                        <ui:VisualElement class="og-option">
                            <ui:VisualElement class="og-icon checkbox" />
                            <ui:Label text="Gluten" class="og-option-name" />
                        </ui:VisualElement>
                        <ui:VisualElement class="og-option">
                            <ui:VisualElement class="og-icon checkbox" />
                            <ui:Label text="Crustáceos" class="og-option-name" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button name="f-clear" text="Quitar filtros" class="clear-filters-btn" />
            </ui:VisualElement>
        </ui:ScrollView>

        <!-- ============================================================
             Bottom sheet: Asistencia (equivalente a #asistenciaSheet)
             ============================================================ -->
        <ui:VisualElement name="asistencia-backdrop" class="sheet-backdrop" />

        <ui:VisualElement name="asistencia-sheet" class="sheet">
            <ui:VisualElement name="asistencia-sheet-handle" class="sheet-handle" />
            <ui:VisualElement class="sheet-body asistencia-body">
                <ui:Label text="¿Quieres que venga un camarero/a?" class="sheet-name font-titulo asistencia-title" />
                <ui:VisualElement class="asistencia-btn-row">
                    <ui:Button name="asistencia-cancel" text="Cancelar" class="asistencia-cancel-btn" />
                    <ui:Button name="asistencia-confirm" text="Sí, avisar" class="asistencia-confirm-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================
             Toast genérico (equivalente a #gastraliToast)
             ============================================================ -->
        <ui:Label name="toast" class="toast" style="display:none;" />

        <!-- ============================================================
             Splash de marca — se oculta con código (clase splash-hidden)
             tras cargar los datos, igual que el original.
             ============================================================ -->
        <ui:VisualElement name="brand-splash" class="brand-splash">
            <ui:VisualElement name="brand-splash-logo" class="brand-splash-logo" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/DetallePlato/DetallePlato.uss?fileID=7433441132597879392&amp;guid=e848f12b89d19b14d89300f5c9616a11&amp;type=3#DetallePlato"/>
    <ui:VisualElement name="overlay" class="overlay">
        <ui:VisualElement name="card" class="card">
            <ui:VisualElement name="top-row" class="top-row">
                <ui:VisualElement name="image-container" class="image-container">
                    <ui:VisualElement name="dish-image" class="dish-image"/>
                </ui:VisualElement>
                <ui:ScrollView name="content-scroll" class="content-scroll">
                    <ui:VisualElement name="content" class="content">
                        <ui:VisualElement name="header-row" class="header-row">
                            <ui:Label name="dish-name" text="Nombre del plato" class="dish-name"/>
                            <ui:Label name="dish-price" text="0,00 €" class="dish-price"/>
                        </ui:VisualElement>
                        <ui:Label name="dish-description" text="Descripcion del plato" class="dish-description"/>
                        <ui:Label text="ALÉRGENOS" name="allergens-title" class="section-title"/>
                        <ui:VisualElement name="allergens-row" class="chip-row"/>
                        <ui:VisualElement name="veg-row" class="chip-row"/>
                        <ui:VisualElement name="options-container" class="options-container"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="footer-row" class="footer-row">
                <ui:VisualElement name="quantity-selector" class="quantity-selector">
                    <ui:Button name="btn-minus" text="-" class="qty-button"/>
                    <ui:Label name="quantity-label" text="1" class="qty-label"/>
                    <ui:Button name="btn-plus" text="+" class="qty-button"/>
                </ui:VisualElement>
                <ui:Button name="btn-add" text="Añadir   0,00 €" class="add-button"/>
            </ui:VisualElement>
            <ui:Button name="btn-close" text="✕" class="close-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

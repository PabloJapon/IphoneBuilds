.pedidos-view {
    flex-grow: 1;
    position: absolute;
    top: 90px;
    bottom: 0;
    right: 570px;
    width: 550px;
    background-color: rgb(245, 245, 247);
    padding: 24px;
    -unity-font-definition: resource("Fonts/OpenSans SDF 1");
}

.pedidos-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.pedidos-title {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: -6px;
    color: rgb(30, 30, 34);
    flex-grow: 1;
}

.pedidos-close {
    width: 32px;
    height: 32px;
    background-color: rgb(240, 240, 242);
    color: rgb(90, 90, 96);
    border-width: 0;
    border-radius: 16px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: -6px;
    padding: 0;
}

.pedidos-list-column {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(225, 225, 228);
    overflow: hidden;
}

.pedidos-scroll {
    flex-grow: 1;
}

.pedido-card {
    padding: 18px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(235, 235, 238);
}

.pedido-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.pedido-fecha {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: -6px;
    color: rgb(40, 40, 44);
    flex-grow: 1;
}

.pedido-tipo-badge {
    padding: 4px 12px;
    border-radius: 10px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: -6px;
    background-color: rgb(230, 240, 255);
    color: rgb(30, 90, 180);
    margin-right: 10px;
}

.pedido-items {
    margin-bottom: 12px;
}

.pedido-item-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.pedido-item-cantidad {
    width: 40px;
    font-size: 20px;
    color: rgb(120, 120, 125);
}

.pedido-item-nombre {
    flex-grow: 1;
    font-size: 20px;
    color: rgb(60, 60, 65);
    white-space: normal;
}

.pedido-seleccionar-btn {
    background-color: rgb(102, 153, 255);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: -6px;
    align-self: flex-end;
}

.pedidos-empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(150, 150, 155);
    padding: 60px 20px;
    white-space: normal;
}

Button,
Button:hover,
Button:focus,
Button:active,
Button:focus:hover,
Button:hover:active,
Button:focus:active {
    background-image: none !important;
    opacity: 1 !important;
    scale: 1 1 !important;
    transition-duration: 0s !important;
}

.pedidos-close,
.pedidos-close:hover, .pedidos-close:focus, .pedidos-close:active {
    background-color: rgb(240, 240, 242) !important;
    border-width: 0 !important;
}

.pedido-seleccionar-btn,
.pedido-seleccionar-btn:hover, .pedido-seleccionar-btn:focus, .pedido-seleccionar-btn:active {
    background-color: rgb(102, 153, 255) !important;
    border-width: 0 !important;
}